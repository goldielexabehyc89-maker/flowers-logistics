// Схема этапа 1: только фундамент, авторизация, роли, аудит и примитивы интеграции.
//
// Таблицы заказов, маршрутов и финансов сознательно НЕ проектируются: их поля определяются
// после read-only исследования МоегоСклада (этап 2). Состояния домена описаны в
// docs/DOMAIN_STATES.md.
//
// Правила:
//  * миграции только forward-only;
//  * сотрудники и курьеры физически не удаляются — только заморозка/разморозка;
//  * внешние ключи на пользователя используют onDelete: Restrict, чтобы удаление было невозможно.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

// Строка подключения задаётся в prisma.config.ts (Prisma 7 убрал `url` из schema.prisma)
// и передаётся клиенту через driver adapter @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LOGISTICIAN
  COURIER
  WAREHOUSE
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  FROZEN
}

enum VehicleType {
  CAR
  FOOT
}

enum AuthAttemptKind {
  LOGIN
  ACTIVATION
  PIN_SET
  REFRESH
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
  DEAD
}

enum IntegrationState {
  NOT_CONFIGURED
  CONFIGURED
  OK
  DEGRADED
  ERROR
}

/// Пользователь системы. Один пользователь может иметь несколько ролей.
/// Записи не удаляются никогда: недоступность выражается статусом FROZEN.
model User {
  id       String     @id @default(uuid(7)) @db.Uuid
  /// Телефон в нормализованном виде E.164 (+7XXXXXXXXXX). Логин пользователя.
  phone    String     @unique
  fullName String
  status   UserStatus @default(PENDING_ACTIVATION)

  /// Стойкий хеш PIN (argon2id + серверный pepper). Открытый PIN нигде не хранится.
  pinHash  String?
  pinSetAt DateTime?

  /// Увеличивается при заморозке и сбросе PIN: делает недействительными все выданные
  /// access-токены немедленно, не дожидаясь их истечения.
  sessionVersion Int @default(0)

  /// Версия записи для оптимистической блокировки при конкурентном редактировании.
  version Int @default(0)

  comment  String?
  frozenAt DateTime?

  /// Кто создал запись. Автор изменений и заморозки фиксируется в AuditLog.
  createdById  String? @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           UserRoleAssignment[]
  courierProfile  CourierProfile?
  activationCodes ActivationCode[]     @relation("ActivationCodeUser")
  issuedCodes     ActivationCode[]     @relation("ActivationCodeIssuer")
  sessions        RefreshSession[]
  authAttempts    AuthAttempt[]
  auditEntries    AuditLog[]
  settingUpdates  SystemSetting[]
  realtimeEvents  RealtimeEvent[]

  createdRoutes    DeliveryRoute[] @relation("RouteCreatedBy")
  assignedRoutes   DeliveryRoute[] @relation("RouteCourier")
  addedRouteOrders RouteOrder[]    @relation("RouteOrderAddedBy")
  removedRouteOrders RouteOrder[]  @relation("RouteOrderRemovedBy")
  routeTransitions RouteStateTransition[]
  routeEditLeases  RouteEditLease[]
  geoChanges         OrderGeoHistory[]

  @@index([status])
  @@index([createdAt])
}

/// Роли пользователя (many-to-many без отдельной таблицы ролей: набор ролей фиксирован).
model UserRoleAssignment {
  userId     String   @db.Uuid
  role       Role
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, role])
  @@index([role])
}

/// Профиль курьера. Создаётся для пользователя с ролью COURIER.
/// Баланс и финансовые данные появятся на этапе 7 и здесь сознательно отсутствуют.
model CourierProfile {
  userId             String      @id @db.Uuid
  defaultVehicleType VehicleType @default(CAR)
  comment            String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

/// Одноразовый код первичной активации и сброса PIN. Хранится только хеш.
/// Код действует 30 минут; новый код инвалидирует предыдущий.
model ActivationCode {
  id       String @id @default(uuid(7)) @db.Uuid
  userId   String @db.Uuid
  codeHash String

  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?

  /// Пока код активен, поле равно userId; при погашении или инвалидации становится NULL.
  /// Уникальный индекс по нему даёт «не более одного активного кода на пользователя»
  /// средствами Prisma, без внешних частичных индексов (NULL в PostgreSQL не конфликтуют).
  activeKey String? @unique @db.Uuid

  issuedById String?  @db.Uuid
  createdAt  DateTime @default(now())

  user     User  @relation("ActivationCodeUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy User? @relation("ActivationCodeIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Refresh-сессия устройства. Несколько устройств = несколько семей (familyId).
/// Ротация выполняется с обнаружением повторного использования токена.
model RefreshSession {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @db.Uuid
  /// Идентификатор цепочки ротаций одного устройства.
  familyId  String @db.Uuid
  /// Хеш refresh-токена. Открытый токен в базе не хранится.
  tokenHash String @unique

  /// Преемник, зашифрованный AES-256-GCM, на время grace-окна (30 секунд).
  /// Нужен, чтобы повторный запрос с потерянным ответом получил ТОТ ЖЕ токен,
  /// а не создал вторую активную ветку. Затирается по истечении grace.
  successorTokenEnc String?
  graceUntil        DateTime?

  deviceLabel String?
  ip          String?
  userAgent   String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  rotatedAt  DateTime?

  /// Ссылка на выданную взамен сессию. Позволяет отличить нормальную ротацию
  /// от повторного использования уже ротированного токена.
  replacedById String?         @unique @db.Uuid
  replacedBy   RefreshSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces     RefreshSession? @relation("SessionRotation")

  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([graceUntil])
}

/// Журнал попыток входа и активации. Используется для расследований и защиты от перебора.
model AuthAttempt {
  id        BigInt          @id @default(autoincrement())
  /// Нормализованный телефон из запроса, даже если такого пользователя нет.
  phone     String
  userId    String?         @db.Uuid
  kind      AuthAttemptKind
  success   Boolean
  ip        String?
  userAgent String?
  /// Причина отказа в виде кода (без секретных значений).
  reason    String?
  createdAt DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Счётчик прогрессивной блокировки. Ключ вида "phone:+7..." или "ip:1.2.3.4".
model AuthLockout {
  key           String    @id
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lastFailedAt  DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

/// Неизменяемый аудит. UPDATE и DELETE запрещены триггером на уровне базы (см. миграцию).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now())
  actorUserId String?  @db.Uuid
  /// Снимок ролей автора на момент действия.
  actorRoles  Role[]
  /// Код действия, например USER_FROZEN, PIN_RESET, ACTIVATION_CODE_ISSUED.
  action      String
  entityType  String
  entityId    String?
  /// Значения до и после. Секреты и открытые коды сюда не попадают никогда.
  oldValue    Json?
  newValue    Json?
  ip          String?
  userAgent   String?
  /// Источник действия: api, bootstrap, worker.
  source      String   @default("api")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
}

/// Версионируемая системная настройка.
/// Хранит ТОЛЬКО несекретные значения: адрес склада, вместимость, длительность маршрута и т. п.
/// Токены и ключи интеграций сюда не попадают никогда — они живут в переменных окружения
/// или в отдельном серверном зашифрованном хранилище (см. docs/ARCHITECTURE.md).
model SystemSetting {
  id      String @id @default(uuid(7)) @db.Uuid
  key     String
  version Int

  value Json

  /// Пока версия актуальна, поле равно key; у исторических версий — NULL.
  /// Даёт «ровно одна текущая версия на ключ» без частичных индексов.
  currentKey String? @unique

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([key, version])
  @@index([key, createdAt])
}

/// Событие realtime. Пишется в одной транзакции с бизнес-изменением,
/// поэтому «изменение есть, а события нет» невозможно.
/// LISTEN/NOTIFY только ускоряет доставку; при переподключении пропущенное читается отсюда.
model RealtimeEvent {
  id         BigInt   @id @default(autoincrement())
  topic      String
  /// Персональный адресат: если задан, событие видит только этот пользователь.
  audienceUserId String? @db.Uuid
  /// Роли-адресаты: событие видят пользователи с любой из перечисленных ролей.
  /// Пустой список вместе с пустым audienceUserId означает «никому» — это защищает
  /// от случайной широковещательной рассылки административных данных курьерам.
  audienceRoles  Role[]
  payload    Json
  occurredAt DateTime @default(now())
  /// Граница хранения (24 часа). За её пределами клиент получает resync-required.
  expiresAt  DateTime

  audienceUser User? @relation(fields: [audienceUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([expiresAt])
  @@index([audienceUserId, id])
}

/// Транзакционный outbox для фоновых операций.
/// Запись создаётся в той же транзакции, что и бизнес-изменение.
model OutboxMessage {
  id             String       @id @default(uuid(7)) @db.Uuid
  topic          String
  /// Ключ идемпотентности: повторная постановка того же события не создаёт дубликат.
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)

  attempts     Int      @default(0)
  maxAttempts  Int      @default(10)
  nextAttemptAt DateTime @default(now())
  /// Текст последней ошибки после очистки от секретов и PII.
  lastError    String?

  lockedAt DateTime?
  lockedBy String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

/// Отметка о фактически выполненной обработке. Обеспечивает идемпотентность handler'а
/// при повторной доставке одного и того же сообщения.
model OutboxProcessedMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  handlerName    String
  idempotencyKey String
  processedAt    DateTime @default(now())

  @@unique([handlerName, idempotencyKey])
}

/// Состояние внешней интеграции для индикатора в интерфейсе.
/// На этапе 1 реальных подключений нет: обе записи находятся в состоянии NOT_CONFIGURED.
model IntegrationStatus {
  provider          String           @id
  state             IntegrationState @default(NOT_CONFIGURED)
  lastOkAt          DateTime?
  lastErrorAt       DateTime?
  pendingOperations Int              @default(0)
  /// Только очищенные технические детали: без токенов, cookies, заголовков и PII.
  details           Json?
  updatedAt         DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Этап 3.1 — заказы доставки из МоегоСклада.
//
// Импортируется только подтверждённый исследованием набор полей (docs/MOYSKLAD_MAPPING.md).
// Полные сырые ответы API не хранятся: они содержат больше персональных данных,
// чем нужно логистике, и их состав может измениться на стороне МоегоСклада.
//
// Деньги хранятся ЦЕЛЫМИ копейками в BigInt. Единица подтверждена сверкой с карточкой
// заказа: API отдаёт минорные единицы. Тип с плавающей точкой не используется нигде —
// от него зависят долг курьера и сверка наличных.
// ---------------------------------------------------------------------------

/// Результат разбора свободного текста «Время доставки».
enum DeliveryIntervalKind {
  /// Поле пустое.
  MISSING
  /// Распознан диапазон: заданы начало и конец.
  RANGE
  /// Указано одно время. Диапазон из него НЕ достраивается.
  EXACT
  /// Текст есть, но интервалом не является. Исходное значение сохраняется как есть.
  UNRECOGNIZED
}

/// Почему заказ попал в «Требует внимания». Вычисляется детерминированно
/// из канонического снимка и денежного результата, но не из внешнего статуса.
enum OrderAttentionReason {
  MISSING_DELIVERY_DATE
  /// Значение даты есть, но разобрать его не удалось. Молча считать такой заказ
  /// нормальным нельзя: дата — обязательное поле планирования.
  UNRECOGNIZED_DELIVERY_DATE
  MISSING_INTERVAL
  UNRECOGNIZED_INTERVAL
  MISSING_ADDRESS
  MISSING_RECIPIENT
  CASH_OVERPAYMENT
}

/// Почему заказ перестал относиться к нашей области.
enum OrderScopeExitReason {
  /// Заказ перенесён на другой склад.
  STORE_CHANGED
  /// Способ доставки изменён с «Доставка» на другой.
  DELIVERY_METHOD_CHANGED
  /// Источник архивирован в МоемСкладе.
  SOURCE_ARCHIVED
  /// Источник не найден контрольной сверкой (возможное физическое удаление).
  SOURCE_MISSING
}

/// Причина создания неизменяемой ревизии заказа.
enum OrderRevisionReason {
  INITIAL_IMPORT
  EXTERNAL_UPDATE
  SCOPE_ENTERED
  SCOPE_EXITED
  SOURCE_MISSING
  /// Заказ найден снова после того, как считался отсутствующим.
  SOURCE_RESTORED
}

/// Заказ доставки — текущее состояние импортированной карточки.
///
/// Физическое удаление запрещено триггером базы: заказ может быть исключён
/// из активного планирования, но не стёрт из истории.
model DeliveryOrder {
  id String @id @default(uuid(7)) @db.Uuid

  /// UUID `customerorder` МоегоСклада. Ключ идемпотентности импорта: уникален
  /// и после создания не меняется.
  externalId      String   @unique @db.Uuid
  /// Отображаемый номер заказа. Используется для показа и поиска, но не как ключ.
  externalName    String
  /// Значение `updated` МоегоСклада: курсор delta-синхронизации.
  externalUpdated DateTime
  /// `moment` документа МоегоСклада.
  externalMoment  DateTime?

  /// Внешний статус сохраняется и отображается, но внутренним состоянием не управляет.
  externalStateId   String? @db.Uuid
  externalStateName String?
  externalStateType String?

  /// Склад и способ доставки — два условия принадлежности к нашей области.
  ///
  /// Оба nullable: у ранее импортированного заказа значение может исчезнуть, и тогда
  /// заказ обязан сохраниться с inScope = false, а не уронить проход синхронизации.
  storeId          String? @db.Uuid
  deliveryMethodId String? @db.Uuid

  /// Плановая дата доставки — КАЛЕНДАРНАЯ дата Москвы, тип DATE.
  /// Момент времени здесь хранить нельзя: перевод часовых поясов сдвинул бы день.
  deliveryDate    DateTime? @db.Date
  /// Исходная строка `deliveryPlannedMoment` без потери: нужна для воспроизводимого
  /// сравнения с МоимСкладом.
  deliveryDateRaw String?

  /// Исходный текст «Время доставки» — сохраняется всегда, даже нераспознанный.
  intervalRaw         String?
  intervalKind        DeliveryIntervalKind @default(MISSING)
  /// Минуты от полуночи. Для EXACT заполняется только начало.
  intervalStartMinute Int?
  intervalEndMinute   Int?

  /// Интервал, заданный логистом вручную. Хранится ОТДЕЛЬНО от текста МоегоСклада,
  /// чтобы следующий импорт его не затёр.
  ///
  /// База требует полноты: три поля либо пусты все вместе, либо заполнены все,
  /// причём минуты лежат в пределах суток, а окончание строго позже начала
  /// (CHECK `DeliveryOrder_manual_interval_complete`). Половинчатое значение
  /// выглядело бы как заданное время и попало бы в планирование.
  manualIntervalStartMinute Int?
  manualIntervalEndMinute   Int?
  manualIntervalSetAt       DateTime?

  /// Адрес только из `shipmentAddress`; резервных источников нет.
  address   String?
  /// Весь текст поля «Получатель» целиком, без разделения на имя и телефон.
  recipient String?
  /// Только «Комментарий по доставке». Необязателен.
  comment   String?

  paymentTypeId   String? @db.Uuid
  paymentTypeName String?

  /// Деньги целыми копейками.
  sumMinor      BigInt @default(0)
  payedSumMinor BigInt @default(0)
  /// Курьер принимает деньги только при точном типе оплаты «Наличные/карта на ТТ».
  cashCollectable Boolean @default(false)
  /// max(0, sumMinor - payedSumMinor). Ниже нуля не опускается.
  cashToCollectMinor BigInt @default(0)
  /// payedSum > sum: переплата или ошибка данных, требует проверки.
  cashAnomaly Boolean @default(false)

  /// Относится ли заказ к нашей области прямо сейчас.
  inScope         Boolean               @default(true)
  scopeExitReason OrderScopeExitReason?
  scopeExitedAt   DateTime?
  sourceArchived  Boolean               @default(false)
  /// Источник не найден контрольной сверкой: физическое удаление опросом не видно.
  sourceMissing   Boolean               @default(false)

  needsAttention   Boolean                @default(false)
  attentionReasons OrderAttentionReason[]

  /// Георазрешение адреса. Координаты хранятся целыми микроградусами:
  /// от них зависят порядок объезда и расстояние, а двоичная дробь округляется
  /// незаметно. Микроградус — около 11 сантиметров, чего заведомо достаточно.
  ///
  /// База гарантирует, что координаты существуют ТОЛЬКО в состоянии RESOLVED
  /// и всегда вместе с источником, точностью и временем разрешения. Поэтому
  /// непригодная точка физически не может выглядеть пригодной.
  geoState        OrderGeoState          @default(UNRESOLVED)
  geoSource       OrderGeoSource?
  geoPrecision    OrderGeoPrecision?
  geoLatMicro     Int?
  geoLonMicro     Int?
  geoResolvedAt   DateTime?
  /// Почему точка требует проверки. Заполняется только для NEEDS_REVIEW и FAILED.
  geoReviewReason OrderGeoReviewReason?

  /// Поколение адреса для геокодирования.
  ///
  /// Растёт только при постановке новой версии адреса в очередь. Пара
  /// (orderId, geoGeneration) идентифицирует задание, а ответ провайдера,
  /// вернувшийся после смены адреса, распознаётся как устаревший и отбрасывается.
  geoGeneration   Int                   @default(0)

  /// Оптимистическая блокировка для будущих конкурентных изменений.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions      DeliveryOrderRevision[]
  routeOrders    RouteOrder[]
  geoHistory  OrderGeoHistory[]
  geocodeJobs OrderGeocodeJob[]

  @@index([inScope, deliveryDate])
  @@index([needsAttention])
  @@index([externalUpdated])
  @@index([storeId, deliveryMethodId])
}

/// Неизменяемая история внешних версий заказа.
///
/// Здесь лежат значения полей заказа, поэтому запись защищена триггерами от UPDATE
/// и DELETE: общий `AuditLog` фиксирует только факт и список изменённых полей,
/// но не дублирует персональные данные.
model DeliveryOrderRevision {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Значение `updated` МоегоСклада на момент этой версии.
  externalUpdated DateTime
  receivedAt      DateTime @default(now())

  /// Канонический снимок только подтверждённых импортируемых полей.
  /// Сырой ответ API целиком не сохраняется.
  snapshot     Json
  /// SHA-256 канонического снимка: дешёвая дедупликация без сравнения JSON.
  snapshotHash String
  /// Поля, реально изменившиеся относительно предыдущей ревизии.
  changedFields String[]
  reason        OrderRevisionReason

  @@index([orderId, receivedAt])
  @@index([orderId, externalUpdated])
}

/// Курсор фоновой синхронизации. Отделён от `IntegrationStatus.details`:
/// это рабочее состояние процесса, а не отображаемая диагностика.
///
/// В ветке 3.1 только моделируется; планировщик и проходы появятся в 3.2.
model IntegrationCursor {
  id       String @id @default(uuid(7)) @db.Uuid
  provider String @unique

  /// Верхняя граница обработанного окна по `updated`.
  updatedCursor          DateTime?
  initialLoadCompleted   Boolean   @default(false)
  initialLoadCompletedAt DateTime?
  lastReconciliationAt   DateTime?

  /// Состояние восстановления после сбоя: переживает перезапуск процесса,
  /// поэтому backoff не обнуляется рестартом и не превращается в частый повтор.
  lastAttemptAt       DateTime?
  consecutiveFailures Int       @default(0)
  nextAttemptAt       DateTime?

  /// Техническая версия для безопасного конкурентного обновления.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// --- Этап 4.1. Ручные маршруты-черновики -------------------------------------

/// Состояние маршрута.
///
/// CONFIRMED и CANCELLED объявлены заранее: они нужны модели этапа 4 целиком,
/// но переходы из DRAFT появятся только в ветке 4.2. ACTIVE и COMPLETED
/// сознательно не добавляются — их введёт forward-only миграция этапа 6.
enum RouteState {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Почему заказ покинул состав маршрута.
enum RouteOrderRemovalReason {
  /// Возвращён в нераспределённые.
  RETURNED_TO_UNASSIGNED
  /// Перемещён в другой маршрут; целевой маршрут записан в movedToRouteId.
  MOVED_TO_ANOTHER_ROUTE
  /// Маршрут отменён: участие закрывается вместе с ним, история сохраняется.
  ROUTE_CANCELLED
}

/// Известное расхождение уже распределённого заказа с маршрутом.
///
/// Заказ при этом НЕ удаляется из маршрута автоматически: молчаливое исключение
/// лишило бы логиста возможности заметить проблему. Разрешение всегда ручное.
enum RouteOrderConflictKind {
  /// Дата доставки в МоемСкладе перестала совпадать с датой маршрута.
  DELIVERY_DATE_CHANGED
  /// Заказ вышел из нашей области: другой склад или другой способ доставки.
  SCOPE_LOST
  /// Источник не найден контрольной сверкой.
  SOURCE_MISSING
  /// Источник архивирован в МоемСкладе.
  SOURCE_ARCHIVED
}

/// Маршрут доставки. На этапе 4.1 создаётся только вручную и только как черновик.
///
/// Физическое удаление запрещено триггером: маршрут отменяется с причиной,
/// но не стирается — иначе исчезла бы история распределения заказов.
model DeliveryRoute {
  id String @id @default(uuid(7)) @db.Uuid

  /// Понятный человеку номер вида R-2026-08-07-003. PII не содержит.
  /// Выдаётся атомарно через RouteNumberCounter в той же транзакции.
  number String @unique

  /// Календарная дата Москвы. После создания не изменяется (триггер базы):
  /// перенос на другой день выполняется созданием другого черновика.
  deliveryDate DateTime @db.Date

  state       RouteState  @default(DRAFT)
  vehicleType VehicleType

  /// Назначенный курьер. Пустое значение допустимо: маршрут может существовать
  /// без курьера, назначение состояние маршрута не меняет.
  courierUserId String? @db.Uuid
  courier       User?   @relation("RouteCourier", fields: [courierUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdById String @db.Uuid
  createdBy   User   @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Оптимистическая блокировка. За одну логическую операцию увеличивается ровно один раз.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       RouteOrder[] @relation("RouteOrderRoute")
  movedInOrders RouteOrder[] @relation("RouteOrderMovedTo")
  transitions RouteStateTransition[]
  editLease   RouteEditLease?

  @@index([deliveryDate, state])
  @@index([courierUserId])
}

/// Участие заказа в маршруте с историей.
///
/// Строка не удаляется и не оживляется: повторное добавление ранее удалённого
/// заказа создаёт НОВУЮ строку. Так история распределения остаётся доказательством
/// того, кто, когда и куда переносил заказ.
model RouteOrder {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation("RouteOrderRoute", fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Позиция в маршруте, начиная с 1. Уникальна среди активных участий маршрута.
  position Int

  addedById String   @db.Uuid
  addedBy   User     @relation("RouteOrderAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedAt   DateTime @default(now())

  /// Три поля удаления заполняются вместе и после фиксации не изменяются.
  removedById   String?                  @db.Uuid
  removedBy     User?                    @relation("RouteOrderRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedAt     DateTime?
  removalReason RouteOrderRemovalReason?

  /// Куда ушёл заказ при перемещении. Обязателен ровно при MOVED_TO_ANOTHER_ROUTE.
  movedToRouteId String?        @db.Uuid
  movedToRoute   DeliveryRoute? @relation("RouteOrderMovedTo", fields: [movedToRouteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  conflicts RouteOrderConflict[]

  @@index([routeId, position])
  @@index([orderId])
}

/// Конфликт распределённого заказа. Неизменяемая запись.
///
/// Отдельная таблица, а не поле участия: заказ может одновременно сменить дату,
/// выйти из области и оказаться архивированным, и одно поле потеряло бы часть причин.
/// Пара (участие, вид) уникальна, поэтому повторный overlap-проход синхронизации
/// не создаёт дубликат и не уведомляет логистов второй раз.
model RouteOrderConflict {
  id String @id @default(uuid(7)) @db.Uuid

  routeOrderId String     @db.Uuid
  routeOrder   RouteOrder @relation(fields: [routeOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  kind       RouteOrderConflictKind
  detectedAt DateTime               @default(now())

  @@unique([routeOrderId, kind])
  @@index([routeOrderId])
}

/// Счётчик номеров маршрутов по дням.
///
/// Инкремент выполняется одним оператором INSERT ... ON CONFLICT DO UPDATE
/// в той же транзакции, что и создание маршрута: откат создания откатывает
/// и номер. Сериализуются только маршруты одного дня.
model RouteNumberCounter {
  deliveryDate DateTime @id @db.Date
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt
}


/// Неизменяемая история переходов состояния маршрута.
///
/// `DeliveryRoute.state` — текущее состояние, эта таблица — доказательство того,
/// кто, когда и почему его менял. Причина после записи не изменяется: переписанное
/// объяснение отмены обесценило бы всю историю.
model RouteStateTransition {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fromState RouteState
  toState   RouteState

  actorUserId String @db.Uuid
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  occurredAt DateTime @default(now())

  /// Обязательна при возврате в черновик и при отмене; при подтверждении отсутствует.
  /// Длина ограничена базой: 3–500 символов.
  reason String?

  @@index([routeId, occurredAt])
}

/// Мягкая блокировка редактора черновика.
///
/// Одна строка на маршрут: это операционное состояние «кто сейчас редактирует»,
/// а не история — история действий с блокировкой живёт в `AuditLog`.
///
/// Держатель определяется парой «пользователь + семья сессий»: один человек
/// с двух устройств — это два редактора, и второе устройство не должно молча
/// перехватывать правки первого.
///
/// Блокировка мягкая: она истекает по времени, её можно безопасно перехватить,
/// и она не держит открытой транзакцию PostgreSQL между запросами.
model RouteEditLease {
  routeId String        @id @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  holderUserId String @db.Uuid
  holder       User   @relation(fields: [holderUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Семья сессий устройства. Наружу не возвращается никогда.
  holderFamilyId String @db.Uuid

  acquiredAt  DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  expiresAt   DateTime
  releasedAt  DateTime?

  /// Версия для конкурентного перехвата: takeover обязан назвать ту, что видел.
  version Int @default(1)

  @@index([holderUserId])
  @@index([expiresAt])
}


// --- Этап 5.1. Геоданные заказа ---------------------------------------------

/// Состояние георазрешения адреса заказа.
enum OrderGeoState {
  /// Точка ещё не запрашивалась.
  UNRESOLVED
  /// Запрос к геокодеру поставлен в очередь (ветка 5.2).
  PENDING
  /// Точка пригодна для планирования.
  RESOLVED
  /// Точка есть в истории, но пользоваться ею нельзя: нужна проверка человеком.
  NEEDS_REVIEW
  /// Геокодер отказал окончательно.
  FAILED
}

/// Откуда взялась точка.
enum OrderGeoSource {
  /// Production-геокодер (ветка 5.2).
  DADATA
  /// Логист поставил точку руками.
  MANUAL
  /// Синтетический набор staging. Production-процесс такие точки не создаёт.
  SYNTHETIC
}

/// Насколько точно найден адрес.
enum OrderGeoPrecision {
  EXACT_HOUSE
  NEARBY_HOUSE
  STREET
  LOCALITY
  UNKNOWN
}

/// Почему точка требует проверки.
enum OrderGeoReviewReason {
  /// Адрес в МоемСкладе изменился: прежняя точка больше не относится к заказу.
  ADDRESS_CHANGED
  /// Геокодер нашёл только улицу или населённый пункт.
  LOW_PRECISION
  /// Провайдер вернул отказ или не ответил.
  PROVIDER_FAILED
  /// Проверку запросил человек.
  MANUAL_CHECK
}

/// Что произошло с геоданными заказа.
enum OrderGeoChangeKind {
  /// Логист поставил точку руками.
  MANUAL_SET
  /// Точка обесценена сменой адреса.
  INVALIDATED_ADDRESS_CHANGED
  /// Адрес поставлен в очередь геокодирования.
  GEOCODE_REQUESTED
  /// Провайдер вернул точный дом.
  GEOCODE_RESOLVED
  /// Провайдер ответил, но точность недостаточна: нужна проверка человеком.
  GEOCODE_LOW_PRECISION
  /// Повторы исчерпаны: провайдер не смог ответить.
  GEOCODE_FAILED
}

/// Состояние задания геокодирования.
enum GeocodeJobStatus {
  PENDING
  PROCESSING
  /// Задание завершено: результат применён либо признан устаревшим.
  DONE
  /// Повторы исчерпаны. Заказ переведён в FAILED и ждёт человека.
  FAILED
}

/// Очередь геокодирования адресов.
///
/// Отдельная таблица, а не тема существующего outbox: обработчик outbox
/// выполняется ВНУТРИ транзакции, а держать транзакцию открытой во время
/// обращения к внешнему сервису нельзя — соединение с базой занималось бы
/// на всё время сетевой задержки, а строка заказа оставалась бы заблокированной.
///
/// Адреса здесь нет намеренно. Задание ссылается на заказ и поколение адреса,
/// а сам адрес читается из заказа непосредственно перед запросом. Так очередь
/// не превращается во вторую копию персональных данных, а ответ, вернувшийся
/// после смены адреса, невозможно применить к новому адресу по ошибке.
model OrderGeocodeJob {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Поколение адреса на момент постановки. Вместе с orderId — тождество задания.
  geoGeneration Int

  status        GeocodeJobStatus @default(PENDING)
  attempts      Int              @default(0)
  maxAttempts   Int              @default(5)
  nextAttemptAt DateTime         @default(now())

  /// Аренда: кто и когда взял задание в работу.
  lockedAt DateTime?
  lockedBy String?

  /// Только безопасный код отказа. Ни текста провайдера, ни адреса, ни координат.
  lastErrorCode String?
  /// Сколько раз результат оказался устаревшим. Полезно при разборе, PII не содержит.
  staleResults  Int     @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  /// Одно задание на одно поколение адреса: повтор того же снимка не создаёт дубликат.
  @@unique([orderId, geoGeneration])
  @@index([status, nextAttemptAt])
}

/// Есть ли данные о текущей дорожной обстановке в расчёте.
///
/// Собственная Valhalla считает по статическим скоростям OSM. Называть это
/// «пробками» нельзя: цифра выглядела бы как знание о текущей ситуации,
/// которого у нас нет. Режим хранится вместе с результатом и входит в ключ
/// кэша, поэтому платный источник времени можно будет добавить позже,
/// не переписывая доменную модель и не смешивая старые расчёты с новыми.
enum TrafficMode {
  /// Данных о времени в пути нет вовсе.
  NONE
  /// Статические скорости дорожного графа. Текущей обстановки не отражают.
  STATIC
}

enum MatrixCacheStatus {
  /// Расчёт занят одним экземпляром приложения. Остальные ждут результата.
  PENDING
  READY
  /// Расчёт не удался. Ошибка не выдаётся за успех и не переживает TTL.
  FAILED
}

/// Кэш матриц времени и расстояния.
///
/// Матрица на N точках — это N² пар, и повторять её расчёт при каждом
/// обращении к планировщику незачем: граф между запросами не меняется.
///
/// Исходные координаты здесь НЕ хранятся вторым снимком: в ключ входит их
/// упорядоченный набор, а наружу уходит только SHA-256 ключа. Так кэш не
/// становится ещё одной копией геоданных заказов.
model RouteMatrixCache {
  id String @id @default(uuid(7)) @db.Uuid

  /// SHA-256 канонического ключа: ревизия графа, профиль, режим трафика,
  /// упорядоченный набор координат и влияющие на расчёт параметры.
  keyHash String @unique

  /// Идентичность дорожного графа: SHA-256 файла tiles.tar.
  ///
  /// Обязательна: расчёт по другому графу — другой ответ, и переиспользовать
  /// его нельзя. Содержимое, а не время файла: скопированный набор остаётся
  /// тем же графом, а подменённый с прежним временем — не остаётся.
  /// Формат закреплён ограничением базы: ровно 64 шестнадцатеричных символа.
  graphSha256 String
  profile       VehicleType
  trafficMode   TrafficMode
  pointCount    Int

  status MatrixCacheStatus @default(PENDING)

  /// Направленные матрицы: целые секунды и целые метры. Недостижимая пара —
  /// явный null, а не ноль: ноль означал бы «точки совпадают».
  durationsSec Json?
  distancesM   Json?

  computedAt DateTime?
  expiresAt  DateTime?

  /// Аренда расчёта: два экземпляра не считают один ключ одновременно.
  lockedAt DateTime?
  lockedBy String?

  attempts      Int     @default(0)
  /// Только безопасный код отказа. Ни координат, ни тела ответа.
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([status, lockedAt])
}

/// Общее состояние провайдера геокодирования.
///
/// Экземпляров приложения несколько, а лимит темпа, баланс и ключ у провайдера
/// общие. Поле «время последнего запроса» внутри объекта клиента ничего не знает
/// о запросе соседнего процесса, поэтому и минимальный интервал, и пауза после
/// 429, и остановка при неверном ключе живут в базе, а не в памяти.
model GeocodingProviderState {
  /// Singleton: строка ровно одна.
  id String @id @default("dadata")

  /// Раньше этого времени следующий запрос начинать нельзя.
  /// Обслуживает и обычный интервал между запросами, и паузу после 429.
  nextRequestAllowedAt DateTime @default(now())

  /// Причина полной остановки обращений: неверный ключ, отозванные права,
  /// отсутствие ключей. Снимается только при запуске с исправленной настройкой.
  haltedReason String?
  haltedAt     DateTime?

  updatedAt DateTime @updatedAt
}

/// Неизменяемая история геоданных заказа.
///
/// Адрес здесь не хранится намеренно: история отвечает на вопрос «какая точка
/// была и почему она сменилась», а сам адрес живёт в заказе и его ревизиях.
/// Сырые ответы будущих провайдеров тоже не сохраняются.
model OrderGeoHistory {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  kind       OrderGeoChangeKind
  occurredAt DateTime           @default(now())

  /// Состояние и точка ПОСЛЕ изменения. У инвалидации координат нет.
  state     OrderGeoState
  source    OrderGeoSource?
  precision OrderGeoPrecision?
  latMicro  Int?
  lonMicro  Int?

  /// Прежняя точка: она перестаёт быть текущей, но остаётся доказательством.
  previousLatMicro Int?
  previousLonMicro Int?

  reviewReason OrderGeoReviewReason?
  /// Пояснение человека. Обязательно для ручной установки, 3–500 символов.
  reason       String?

  /// Автор. Пусто у системной инвалидации: её выполняет синхронизация.
  actorUserId String? @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, occurredAt])
}
