// Схема этапа 1: только фундамент, авторизация, роли, аудит и примитивы интеграции.
//
// Таблицы заказов, маршрутов и финансов сознательно НЕ проектируются: их поля определяются
// после read-only исследования МоегоСклада (этап 2). Состояния домена описаны в
// docs/DOMAIN_STATES.md.
//
// Правила:
//  * миграции только forward-only;
//  * сотрудники и курьеры физически не удаляются — только заморозка/разморозка;
//  * внешние ключи на пользователя используют onDelete: Restrict, чтобы удаление было невозможно.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

// Строка подключения задаётся в prisma.config.ts (Prisma 7 убрал `url` из schema.prisma)
// и передаётся клиенту через driver adapter @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LOGISTICIAN
  COURIER
  WAREHOUSE
  /// Собирает заказы. Значения добавлены в КОНЕЦ перечисления: PostgreSQL хранит
  /// порядок объявления, и вставка в середину сдвинула бы существующие значения.
  FLORIST
  /// Выдаёт самовывозные заказы покупателю. Логистика, склад и настройки ей недоступны.
  MANAGER
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  FROZEN
}

enum VehicleType {
  CAR
  FOOT
}

enum AuthAttemptKind {
  LOGIN
  ACTIVATION
  PIN_SET
  REFRESH
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
  DEAD
}

enum IntegrationState {
  NOT_CONFIGURED
  CONFIGURED
  OK
  DEGRADED
  ERROR
}

/// Пользователь системы. Один пользователь может иметь несколько ролей.
/// Записи не удаляются никогда: недоступность выражается статусом FROZEN.
model User {
  id       String     @id @default(uuid(7)) @db.Uuid
  /// Телефон в нормализованном виде E.164 (+7XXXXXXXXXX). Логин пользователя.
  phone    String     @unique
  fullName String
  status   UserStatus @default(PENDING_ACTIVATION)

  /// Стойкий хеш PIN (argon2id + серверный pepper). Открытый PIN нигде не хранится.
  pinHash  String?
  pinSetAt DateTime?

  /// Увеличивается при заморозке и сбросе PIN: делает недействительными все выданные
  /// access-токены немедленно, не дожидаясь их истечения.
  sessionVersion Int @default(0)

  /// Версия записи для оптимистической блокировки при конкурентном редактировании.
  version Int @default(0)

  comment  String?
  frozenAt DateTime?

  /// Кто создал запись. Автор изменений и заморозки фиксируется в AuditLog.
  createdById  String? @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           UserRoleAssignment[]
  courierProfile  CourierProfile?
  activationCodes ActivationCode[]     @relation("ActivationCodeUser")
  issuedCodes     ActivationCode[]     @relation("ActivationCodeIssuer")
  sessions        RefreshSession[]
  authAttempts    AuthAttempt[]
  auditEntries    AuditLog[]
  settingUpdates  SystemSetting[]
  realtimeEvents  RealtimeEvent[]

  createdRoutes      DeliveryRoute[]        @relation("RouteCreatedBy")
  assignedRoutes     DeliveryRoute[]        @relation("RouteCourier")
  addedRouteOrders   RouteOrder[]           @relation("RouteOrderAddedBy")
  removedRouteOrders RouteOrder[]           @relation("RouteOrderRemovedBy")
  routeTransitions   RouteStateTransition[]
  routeEditLeases    RouteEditLease[]
  geoChanges         OrderGeoHistory[]

  floristShifts       FloristShift[]  @relation("FloristShiftUser")
  closedFloristShifts FloristShift[]  @relation("FloristShiftClosedBy")
  assignedFulfillment DeliveryOrder[] @relation("OrderFulfillmentAssignee")
  assembledOrders     DeliveryOrder[] @relation("OrderFulfillmentAssembledBy")
  completedPrintJobs  OrderPrintJob[] @relation("PrintJobCompletedBy")

  createdDepots     Depot[]                @relation("DepotCreatedBy")
  requestedPlanRuns RoutePlanRun[]         @relation("PlanRunRequestedBy")
  appliedPlanRuns   RoutePlanRun[]         @relation("PlanRunAppliedBy")
  planVehicleSlots  RoutePlanVehicleSlot[] @relation("PlanSlotCourier")

  createdStorageCells StorageCell[] @relation("StorageCellCreatedBy")
  changedStorageCells StorageCell[] @relation("StorageCellChangedBy")

  placedOrders      OrderPlacement[]   @relation("PlacementPlacedBy")
  releasedOrders    OrderPlacement[]   @relation("PlacementReleasedBy")
  boundRouteCells   RouteCellBinding[] @relation("RouteCellBoundBy")
  unboundRouteCells RouteCellBinding[] @relation("RouteCellReleasedBy")
  issuedRoutes      RouteIssueSession[] @relation("IssueSessionCourier")
  confirmedIssues   RouteIssueSession[] @relation("IssueSessionConfirmedBy")
  cancelledIssues   RouteIssueSession[] @relation("IssueSessionCancelledBy")

  @@index([status])
  @@index([createdAt])
}

/// Роли пользователя (many-to-many без отдельной таблицы ролей: набор ролей фиксирован).
model UserRoleAssignment {
  userId     String   @db.Uuid
  role       Role
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, role])
  @@index([role])
}

/// Профиль курьера. Создаётся для пользователя с ролью COURIER.
/// Баланс и финансовые данные появятся на этапе 7 и здесь сознательно отсутствуют.
model CourierProfile {
  userId             String      @id @db.Uuid
  defaultVehicleType VehicleType @default(CAR)
  comment            String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

/// Одноразовый код первичной активации и сброса PIN. Хранится только хеш.
/// Код действует 30 минут; новый код инвалидирует предыдущий.
model ActivationCode {
  id       String @id @default(uuid(7)) @db.Uuid
  userId   String @db.Uuid
  codeHash String

  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?

  /// Пока код активен, поле равно userId; при погашении или инвалидации становится NULL.
  /// Уникальный индекс по нему даёт «не более одного активного кода на пользователя»
  /// средствами Prisma, без внешних частичных индексов (NULL в PostgreSQL не конфликтуют).
  activeKey String? @unique @db.Uuid

  issuedById String?  @db.Uuid
  createdAt  DateTime @default(now())

  user     User  @relation("ActivationCodeUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy User? @relation("ActivationCodeIssuer", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Refresh-сессия устройства. Несколько устройств = несколько семей (familyId).
/// Ротация выполняется с обнаружением повторного использования токена.
model RefreshSession {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @db.Uuid
  /// Идентификатор цепочки ротаций одного устройства.
  familyId  String @db.Uuid
  /// Хеш refresh-токена. Открытый токен в базе не хранится.
  tokenHash String @unique

  /// Преемник, зашифрованный AES-256-GCM, на время grace-окна (30 секунд).
  /// Нужен, чтобы повторный запрос с потерянным ответом получил ТОТ ЖЕ токен,
  /// а не создал вторую активную ветку. Затирается по истечении grace.
  successorTokenEnc String?
  graceUntil        DateTime?

  deviceLabel String?
  ip          String?
  userAgent   String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  rotatedAt  DateTime?

  /// Ссылка на выданную взамен сессию. Позволяет отличить нормальную ротацию
  /// от повторного использования уже ротированного токена.
  replacedById String?         @unique @db.Uuid
  replacedBy   RefreshSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces     RefreshSession? @relation("SessionRotation")

  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([graceUntil])
}

/// Журнал попыток входа и активации. Используется для расследований и защиты от перебора.
model AuthAttempt {
  id        BigInt          @id @default(autoincrement())
  /// Нормализованный телефон из запроса, даже если такого пользователя нет.
  phone     String
  userId    String?         @db.Uuid
  kind      AuthAttemptKind
  success   Boolean
  ip        String?
  userAgent String?
  /// Причина отказа в виде кода (без секретных значений).
  reason    String?
  createdAt DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Счётчик прогрессивной блокировки. Ключ вида "phone:+7..." или "ip:1.2.3.4".
model AuthLockout {
  key           String    @id
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lastFailedAt  DateTime  @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

/// Неизменяемый аудит. UPDATE и DELETE запрещены триггером на уровне базы (см. миграцию).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now())
  actorUserId String?  @db.Uuid
  /// Снимок ролей автора на момент действия.
  actorRoles  Role[]
  /// Код действия, например USER_FROZEN, PIN_RESET, ACTIVATION_CODE_ISSUED.
  action      String
  entityType  String
  entityId    String?
  /// Значения до и после. Секреты и открытые коды сюда не попадают никогда.
  oldValue    Json?
  newValue    Json?
  ip          String?
  userAgent   String?
  /// Источник действия: api, bootstrap, worker.
  source      String   @default("api")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
}

/// Версионируемая системная настройка.
/// Хранит ТОЛЬКО несекретные значения: адрес склада, вместимость, длительность маршрута и т. п.
/// Токены и ключи интеграций сюда не попадают никогда — они живут в переменных окружения
/// или в отдельном серверном зашифрованном хранилище (см. docs/ARCHITECTURE.md).
model SystemSetting {
  id      String @id @default(uuid(7)) @db.Uuid
  key     String
  version Int

  value Json

  /// Пока версия актуальна, поле равно key; у исторических версий — NULL.
  /// Даёт «ровно одна текущая версия на ключ» без частичных индексов.
  currentKey String? @unique

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([key, version])
  @@index([key, createdAt])
}

/// Событие realtime. Пишется в одной транзакции с бизнес-изменением,
/// поэтому «изменение есть, а события нет» невозможно.
/// LISTEN/NOTIFY только ускоряет доставку; при переподключении пропущенное читается отсюда.
model RealtimeEvent {
  id             BigInt   @id @default(autoincrement())
  topic          String
  /// Персональный адресат: если задан, событие видит только этот пользователь.
  audienceUserId String?  @db.Uuid
  /// Роли-адресаты: событие видят пользователи с любой из перечисленных ролей.
  /// Пустой список вместе с пустым audienceUserId означает «никому» — это защищает
  /// от случайной широковещательной рассылки административных данных курьерам.
  audienceRoles  Role[]
  payload        Json
  occurredAt     DateTime @default(now())
  /// Граница хранения (24 часа). За её пределами клиент получает resync-required.
  expiresAt      DateTime

  audienceUser User? @relation(fields: [audienceUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([expiresAt])
  @@index([audienceUserId, id])
}

/// Транзакционный outbox для фоновых операций.
/// Запись создаётся в той же транзакции, что и бизнес-изменение.
model OutboxMessage {
  id             String       @id @default(uuid(7)) @db.Uuid
  topic          String
  /// Ключ идемпотентности: повторная постановка того же события не создаёт дубликат.
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)

  attempts      Int      @default(0)
  maxAttempts   Int      @default(10)
  nextAttemptAt DateTime @default(now())
  /// Текст последней ошибки после очистки от секретов и PII.
  lastError     String?

  lockedAt DateTime?
  lockedBy String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

/// Отметка о фактически выполненной обработке. Обеспечивает идемпотентность handler'а
/// при повторной доставке одного и того же сообщения.
model OutboxProcessedMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  handlerName    String
  idempotencyKey String
  processedAt    DateTime @default(now())

  @@unique([handlerName, idempotencyKey])
}

/// Состояние внешней интеграции для индикатора в интерфейсе.
/// На этапе 1 реальных подключений нет: обе записи находятся в состоянии NOT_CONFIGURED.
model IntegrationStatus {
  provider          String           @id
  state             IntegrationState @default(NOT_CONFIGURED)
  lastOkAt          DateTime?
  lastErrorAt       DateTime?
  pendingOperations Int              @default(0)
  /// Только очищенные технические детали: без токенов, cookies, заголовков и PII.
  details           Json?
  updatedAt         DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Этап 3.1 — заказы доставки из МоегоСклада.
//
// Импортируется только подтверждённый исследованием набор полей (docs/MOYSKLAD_MAPPING.md).
// Полные сырые ответы API не хранятся: они содержат больше персональных данных,
// чем нужно логистике, и их состав может измениться на стороне МоегоСклада.
//
// Деньги хранятся ЦЕЛЫМИ копейками в BigInt. Единица подтверждена сверкой с карточкой
// заказа: API отдаёт минорные единицы. Тип с плавающей точкой не используется нигде —
// от него зависят долг курьера и сверка наличных.
// ---------------------------------------------------------------------------

/// Результат разбора свободного текста «Время доставки».
enum DeliveryIntervalKind {
  /// Поле пустое.
  MISSING
  /// Распознан диапазон: заданы начало и конец.
  RANGE
  /// Указано одно время. Диапазон из него НЕ достраивается.
  EXACT
  /// Текст есть, но интервалом не является. Исходное значение сохраняется как есть.
  UNRECOGNIZED
}

/// Почему заказ попал в «Требует внимания». Вычисляется детерминированно
/// из канонического снимка и денежного результата, но не из внешнего статуса.
enum OrderAttentionReason {
  MISSING_DELIVERY_DATE
  /// Значение даты есть, но разобрать его не удалось. Молча считать такой заказ
  /// нормальным нельзя: дата — обязательное поле планирования.
  UNRECOGNIZED_DELIVERY_DATE
  MISSING_INTERVAL
  UNRECOGNIZED_INTERVAL
  MISSING_ADDRESS
  MISSING_RECIPIENT
  CASH_OVERPAYMENT
}

/// Почему заказ перестал относиться к нашей области.
enum OrderScopeExitReason {
  /// Заказ перенесён на другой склад.
  STORE_CHANGED
  /// Способ доставки изменён с «Доставка» на другой.
  DELIVERY_METHOD_CHANGED
  /// Источник архивирован в МоемСкладе.
  SOURCE_ARCHIVED
  /// Источник не найден контрольной сверкой (возможное физическое удаление).
  SOURCE_MISSING
}

/// Причина создания неизменяемой ревизии заказа.
enum OrderRevisionReason {
  INITIAL_IMPORT
  EXTERNAL_UPDATE
  SCOPE_ENTERED
  SCOPE_EXITED
  SOURCE_MISSING
  /// Заказ найден снова после того, как считался отсутствующим.
  SOURCE_RESTORED
}

/// Заказ доставки — текущее состояние импортированной карточки.
///
/// Физическое удаление запрещено триггером базы: заказ может быть исключён
/// из активного планирования, но не стёрт из истории.
model DeliveryOrder {
  id String @id @default(uuid(7)) @db.Uuid

  /// UUID `customerorder` МоегоСклада. Ключ идемпотентности импорта: уникален
  /// и после создания не меняется.
  externalId      String    @unique @db.Uuid
  /// Отображаемый номер заказа. Используется для показа и поиска, но не как ключ.
  externalName    String
  /// Значение `updated` МоегоСклада: курсор delta-синхронизации.
  externalUpdated DateTime
  /// `moment` документа МоегоСклада.
  externalMoment  DateTime?

  /// Внешний статус сохраняется и отображается, но внутренним состоянием не управляет.
  externalStateId   String? @db.Uuid
  externalStateName String?
  externalStateType String?

  /// Склад и способ доставки — два условия принадлежности к нашей области.
  ///
  /// Оба nullable: у ранее импортированного заказа значение может исчезнуть, и тогда
  /// заказ обязан сохраниться с inScope = false, а не уронить проход синхронизации.
  storeId          String? @db.Uuid
  deliveryMethodId String? @db.Uuid

  /// Плановая дата доставки — КАЛЕНДАРНАЯ дата Москвы, тип DATE.
  /// Момент времени здесь хранить нельзя: перевод часовых поясов сдвинул бы день.
  deliveryDate    DateTime? @db.Date
  /// Исходная строка `deliveryPlannedMoment` без потери: нужна для воспроизводимого
  /// сравнения с МоимСкладом.
  deliveryDateRaw String?

  /// Исходный текст «Время доставки» — сохраняется всегда, даже нераспознанный.
  intervalRaw         String?
  intervalKind        DeliveryIntervalKind @default(MISSING)
  /// Минуты от полуночи. Для EXACT заполняется только начало.
  intervalStartMinute Int?
  intervalEndMinute   Int?

  /// Интервал, заданный логистом вручную. Хранится ОТДЕЛЬНО от текста МоегоСклада,
  /// чтобы следующий импорт его не затёр.
  ///
  /// База требует полноты: три поля либо пусты все вместе, либо заполнены все,
  /// причём минуты лежат в пределах суток, а окончание строго позже начала
  /// (CHECK `DeliveryOrder_manual_interval_complete`). Половинчатое значение
  /// выглядело бы как заданное время и попало бы в планирование.
  manualIntervalStartMinute Int?
  manualIntervalEndMinute   Int?
  manualIntervalSetAt       DateTime?

  /// Адрес только из `shipmentAddress`; резервных источников нет.
  address   String?
  /// Весь текст поля «Получатель» целиком, без разделения на имя и телефон.
  recipient String?
  /// Только «Комментарий по доставке». Необязателен.
  comment   String?

  paymentTypeId   String? @db.Uuid
  paymentTypeName String?

  /// Деньги целыми копейками.
  sumMinor           BigInt  @default(0)
  payedSumMinor      BigInt  @default(0)
  /// Курьер принимает деньги только при точном типе оплаты «Наличные/карта на ТТ».
  cashCollectable    Boolean @default(false)
  /// max(0, sumMinor - payedSumMinor). Ниже нуля не опускается.
  cashToCollectMinor BigInt  @default(0)
  /// payedSum > sum: переплата или ошибка данных, требует проверки.
  cashAnomaly        Boolean @default(false)

  /// Относится ли заказ к ЛОГИСТИЧЕСКОЙ области прямо сейчас: утверждённый склад,
  /// способ получения «Доставка» и не архивирован. Смысл поля не менялся —
  /// на него по-прежнему опираются экраны логиста, маршрутизация, планирование,
  /// конфликты и геокодирование.
  inScope         Boolean               @default(true)
  /// Относится ли заказ к ПРОИЗВОДСТВЕННОЙ области: утверждённый склад и заказ
  /// не архивирован, **независимо от способа получения**. Самовывоз, другое
  /// значение и незаполненный способ сюда входят (`docs/OWNER_DECISIONS.md`,
  /// `FUL-005`).
  ///
  /// Это второе представление ОДНОГО заказа, а не второй заказ: ключ
  /// `externalId` и строка остаются едиными, второго прохода синхронизации
  /// и второй таблицы не существует.
  ///
  /// Инвариант `inScope = true => fulfillmentInScope = true` держит база:
  /// триггер `delivery_order_fulfillment_scope_covers_logistics` дополняет
  /// строку, а ограничение с тем же именем фиксирует само правило. Это нужно
  /// для отката: код прежней версии колонки не знает и записал бы `false`
  /// рядом с `inScope = true`.
  fulfillmentInScope Boolean            @default(false)
  scopeExitReason OrderScopeExitReason?
  scopeExitedAt   DateTime?
  sourceArchived  Boolean               @default(false)
  /// Источник не найден контрольной сверкой: физическое удаление опросом не видно.
  sourceMissing   Boolean               @default(false)

  needsAttention   Boolean                @default(false)
  attentionReasons OrderAttentionReason[]

  /// Георазрешение адреса. Координаты хранятся целыми микроградусами:
  /// от них зависят порядок объезда и расстояние, а двоичная дробь округляется
  /// незаметно. Микроградус — около 11 сантиметров, чего заведомо достаточно.
  ///
  /// База гарантирует, что координаты существуют ТОЛЬКО в состоянии RESOLVED
  /// и всегда вместе с источником, точностью и временем разрешения. Поэтому
  /// непригодная точка физически не может выглядеть пригодной.
  geoState        OrderGeoState         @default(UNRESOLVED)
  geoSource       OrderGeoSource?
  geoPrecision    OrderGeoPrecision?
  geoLatMicro     Int?
  geoLonMicro     Int?
  geoResolvedAt   DateTime?
  /// Почему точка требует проверки. Заполняется только для NEEDS_REVIEW и FAILED.
  geoReviewReason OrderGeoReviewReason?

  /// Поколение адреса для геокодирования.
  ///
  /// Растёт только при постановке новой версии адреса в очередь. Пара
  /// (orderId, geoGeneration) идентифицирует задание, а ответ провайдера,
  /// вернувшийся после смены адреса, распознаётся как устаревший и отбрасывается.
  geoGeneration Int @default(0)

  /// Нижний комментарий заказа — стандартное поле `customerorder.description`.
  ///
  /// Это ТРЕТИЙ независимый источник текста, а не копия логистического
  /// `comment` («Комментарий по доставке») и не «Текст открытки». Совпадение
  /// их содержимого не предполагается, подмена одного другим запрещена
  /// (`docs/OWNER_DECISIONS.md`, `FUL-002` п.6). Логистическая область
  /// `description` намеренно не сохраняет, и её контракт не меняется.
  fulfillmentDescription String?
  /// Атрибут «Текст открытки»: показывается флористу в карточке сборки.
  fulfillmentCardText    String?

  /// Хеш подтверждённого производственного снимка: `description`, «Текст
  /// открытки», позиции и компоненты вместе.
  ///
  /// Имя намеренно не «composition»: в хеш входят и два текста, и состав.
  /// Именно по нему решается, нужна ли новая производственная ревизия;
  /// `externalUpdated` для этого не годится — он меняется и от чужих
  /// логистических полей.
  ///
  /// `null` означает «подтверждённого снимка ещё нет», а не «снимок пуст».
  fulfillmentSnapshotHash String?

  /// Состояние загрузки производственного состава.
  ///
  /// Существует ради одного риска: заказ пришёл delta-проходом, состав получить
  /// не удалось, а курсор ушёл вперёд — и заказ больше никогда не изменится,
  /// то есть delta его не принесёт. Состояние живёт в базе и не зависит от
  /// `customerorder.updated`, поэтому дозагрузка гарантирована независимо
  /// от того, менялся ли заказ.
  ///
  /// `PENDING` — состав ещё не подтверждён; пустая проекция при `PENDING`
  /// НЕ означает «в заказе ничего нет».
  fulfillmentCompositionState    FulfillmentCompositionState @default(PENDING)
  /// Когда состав был подтверждён в последний раз.
  fulfillmentCompositionSyncedAt DateTime?
  /// Сколько раз подряд подтвердить состав не удалось. Двигает порядок дозагрузки,
  /// чтобы один неисправимый заказ не занимал всю квоту прохода.
  fulfillmentCompositionAttempts Int                         @default(0)
  fulfillmentCompositionFailedAt DateTime?
  /// Безопасная причина последнего отказа: короткий код без данных заказа.
  fulfillmentCompositionFailure  String?

  /// Ожидающая подтверждения внешняя версия: тексты и её момент.
  ///
  /// Существуют потому, что подтверждённый снимок — это тексты И состав ВМЕСТЕ.
  /// Записать новый `description` прямо в подтверждённое поле, оставив прежние
  /// хеш и позиции, значит собрать строку из двух разных внешних версий: поля
  /// от новой, состав и хеш от старой. Такая строка выглядит достоверной
  /// и потому опаснее честно неподтверждённой.
  ///
  /// Здесь лежат только два проверенных текста и момент версии — ни сырого
  /// ответа, ни JSON. Очереди дозагрузки этого достаточно, чтобы собрать снимок
  /// без повторного чтения документа заказа.
  ///
  /// Момент версии служит и защитой от устаревшего результата: пока очередь
  /// ходила в сеть за позициями версии B, delta могла записать сюда версию C,
  /// и ответ B обязан быть отброшен, а не подтверждён как C.
  fulfillmentPendingDescription     String?
  fulfillmentPendingCardText        String?
  fulfillmentPendingExternalUpdated DateTime?

  /// Производственный процесс флориста: кто собирает и на каком шаге заказ.
  ///
  /// Отделён от импорта намеренно. Импорт владеет составом и снимком, процесс —
  /// назначением и сборкой. Общая колонка `version` принадлежит синхронизации
  /// и растёт при каждом внешнем изменении; конкурентный захват заказа обязан
  /// опираться на собственный счётчик, иначе обычный delta-проход отменял бы
  /// действие флориста как «устаревшую версию».
  fulfillmentProcessState   OrderFulfillmentProcessState @default(NEW)
  fulfillmentProcessVersion Int                          @default(0)

  /// Единственный флорист, за которым закреплён заказ.
  fulfillmentAssigneeId String? @db.Uuid
  fulfillmentAssignee   User?   @relation("OrderFulfillmentAssignee", fields: [fulfillmentAssigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fulfillmentAssignedAt DateTime?
  /// Смена, в которой заказ взят. Нужна принудительному завершению смены:
  /// оно обязано найти незакрытые назначения, а не потерять их.
  fulfillmentShiftId    String?       @db.Uuid
  fulfillmentShift      FloristShift? @relation("OrderFulfillmentShift", fields: [fulfillmentShiftId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fulfillmentAssembledAt   DateTime?
  fulfillmentAssembledById String?   @db.Uuid
  fulfillmentAssembledBy   User?     @relation("OrderFulfillmentAssembledBy", fields: [fulfillmentAssembledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Ревизия состава, по которой заказ фактически собран. По ней же построен
  /// печатный бланк, и она же сравнивается при последующих изменениях.
  fulfillmentAssembledRevisionId String?                   @db.Uuid
  fulfillmentAssembledRevision   OrderFulfillmentRevision? @relation("OrderAssembledRevision", fields: [fulfillmentAssembledRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Оптимистическая блокировка для будущих конкурентных изменений.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions            DeliveryOrderRevision[]
  routeOrders          RouteOrder[]
  geoHistory           OrderGeoHistory[]
  geocodeJobs          OrderGeocodeJob[]
  fulfillmentPositions DeliveryOrderPosition[]
  fulfillmentRevisions OrderFulfillmentRevision[]
  placements           OrderPlacement[]
  printForms           OrderPrintForm[]
  printJobs            OrderPrintJob[]

  @@index([inScope, deliveryDate])
  @@index([fulfillmentInScope, deliveryDate])
  @@index([needsAttention])
  @@index([externalUpdated])
  @@index([storeId, deliveryMethodId])
  /// Очередь дозагрузки состава: выбираются производственные заказы не в READY.
  @@index([fulfillmentInScope, fulfillmentCompositionState])
  /// Очередь флориста: производственная область, день доставки, шаг процесса.
  @@index([fulfillmentInScope, deliveryDate, fulfillmentProcessState], map: "DeliveryOrder_fulfillmentProcess_idx")
  /// «Мои заказы» и поиск незавершённых назначений при завершении смены.
  @@index([fulfillmentAssigneeId, fulfillmentProcessState], map: "DeliveryOrder_fulfillmentAssignee_idx")
}

/// Неизменяемая история внешних версий заказа.
///
/// Здесь лежат значения полей заказа, поэтому запись защищена триггерами от UPDATE
/// и DELETE: общий `AuditLog` фиксирует только факт и список изменённых полей,
/// но не дублирует персональные данные.
model DeliveryOrderRevision {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Значение `updated` МоегоСклада на момент этой версии.
  externalUpdated DateTime
  receivedAt      DateTime @default(now())

  /// Канонический снимок только подтверждённых импортируемых полей.
  /// Сырой ответ API целиком не сохраняется.
  snapshot      Json
  /// SHA-256 канонического снимка: дешёвая дедупликация без сравнения JSON.
  snapshotHash  String
  /// Поля, реально изменившиеся относительно предыдущей ревизии.
  changedFields String[]
  reason        OrderRevisionReason

  @@index([orderId, receivedAt])
  @@index([orderId, externalUpdated])
}

// --- Производственный состав заказа ------------------------------------------

/// Подтверждён ли производственный состав заказа.
///
/// `PENDING` и пустая проекция — это «ещё не знаем», а не «в заказе ничего нет».
/// Различать их обязательно: подтверждённо пустой состав — нормальный факт,
/// а неподтверждённый пустой — незаконченная работа.
enum FulfillmentCompositionState {
  PENDING
  READY
  FAILED
}

/// Тип номенклатуры позиции состава.
///
/// `VARIANT` объявлен, но фактически поддержанным не считается: модификаций
/// в аккаунте нет ни одной, живой контракт характеристики проверить было не на
/// чем (`FUL-005` п.5). `OTHER` существует, чтобы незнакомый тип не ронял импорт
/// и не исчезал молча; исходное значение сохраняется рядом строкой.
enum FulfillmentAssortmentKind {
  PRODUCT
  SERVICE
  BUNDLE
  VARIANT
  OTHER
}

/// Причина создания производственной ревизии.
enum OrderFulfillmentRevisionReason {
  INITIAL_IMPORT
  EXTERNAL_UPDATE
}

/// Текущая проекция производственного состава заказа.
///
/// ЭТО ПРОЕКЦИЯ, А НЕ ИСТОРИЯ. Изменившийся состав заменяет строки целиком,
/// поэтому запретительных триггеров на удаление здесь нет намеренно: они
/// сделали бы замену состава невозможной. История живёт в
/// `OrderFulfillmentRevision`, которая от UPDATE и DELETE защищена, а сам заказ
/// удалить нельзя (`delivery_order_no_delete`). Поэтому исчезновение строки
/// проекции не уничтожает исторический снимок.
model DeliveryOrderPosition {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// UUID позиции в МоемСкладе. Уникален В ПРЕДЕЛАХ ЗАКАЗА: глобальную
  /// уникальность исследование не доказывало, и объявлять её нельзя.
  externalPositionId String @db.Uuid
  /// Порядковый номер позиции в заказе: даёт воспроизводимый порядок показа
  /// и печати без зависимости от порядка выдачи строк базой.
  ordinal            Int

  assortmentId      String?                   @db.Uuid
  assortmentKind    FulfillmentAssortmentKind
  /// Исходный `meta.type` — чтобы незнакомый тип остался различимым.
  assortmentKindRaw String?
  name              String?

  /// Количество. `DECIMAL`, а не число с плавающей точкой: дробное количество
  /// в букете — обычное дело, а `float` теряет его молча.
  quantity Decimal @db.Decimal(20, 6)

  /// Отображаемая характеристика модификации. Всегда пусто до подтверждения
  /// живого контракта: сырой JSON МоегоСклада здесь хранить запрещено.
  characteristicLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components DeliveryOrderPositionComponent[]

  @@unique([orderId, externalPositionId])
  @@index([orderId, ordinal])
}

/// Компонент позиции-комплекта.
///
/// Компоненты принадлежат КАТАЛОЖНОМУ бандлу, а не заказу, и каталог может
/// измениться задним числом. Поэтому идентичность компонента считается в
/// пределах позиции заказа, а состав, использованный при сборке, замораживается
/// ревизией: иначе вчерашний букет завтра выглядел бы собранным из другого.
model DeliveryOrderPositionComponent {
  id         String                @id @default(uuid(7)) @db.Uuid
  positionId String                @db.Uuid
  position   DeliveryOrderPosition @relation(fields: [positionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  externalComponentId String @db.Uuid
  ordinal             Int

  assortmentId      String?                   @db.Uuid
  assortmentKind    FulfillmentAssortmentKind
  assortmentKindRaw String?
  name              String?
  quantity          Decimal                   @db.Decimal(20, 6)

  createdAt DateTime @default(now())

  @@unique([positionId, externalComponentId])
  @@index([positionId, ordinal])
}

/// Неизменяемая история производственного снимка заказа.
///
/// Отдельно от `DeliveryOrderRevision` намеренно: подмешивание состава в
/// логистический снимок изменило бы хеш КАЖДОЙ уже сохранённой ревизии, и
/// первый же проход объявил бы изменившимися все заказы.
///
/// Снимок содержит `description`, «Текст открытки», позиции и компоненты.
/// `externalUpdated` хранится как источник и контекст, но в хеш не входит:
/// он меняется и от чужих логистических полей.
model OrderFulfillmentRevision {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Значение `updated` МоегоСклада на момент снимка — контекст, не признак.
  externalUpdated DateTime
  receivedAt      DateTime @default(now())

  /// Канонический производственный снимок: только перечисленные поля.
  /// Сырой ответ API целиком не сохраняется никогда.
  snapshot      Json
  snapshotHash  String
  /// Что именно изменилось: `description`, `cardText`, `positions`.
  /// Названий позиций и текста комментариев здесь нет.
  changedFields String[]
  reason        OrderFulfillmentRevisionReason

  printForms    OrderPrintForm[]
  assembledFrom DeliveryOrder[] @relation("OrderAssembledRevision")

  @@index([orderId, receivedAt])
  @@index([orderId, snapshotHash])
}

// --- Смена, сборка и печать флориста -----------------------------------------

/// Как закрылась смена флориста.
enum FloristShiftCloseKind {
  /// Флорист закрыл смену сам.
  SELF
  /// Администратор завершил смену принудительно, с обязательной причиной.
  ADMIN_FORCED
}

/// Производственное состояние заказа у флориста.
///
/// Отдельного состояния «Назначен» нет намеренно: «Взять в работу» одной
/// операцией закрепляет заказ и переводит его в сборку (`FUL-002`).
enum OrderFulfillmentProcessState {
  /// Заказ никто не взял.
  NEW
  /// Заказ закреплён за флористом и собирается.
  IN_ASSEMBLY
  /// Сборка завершена.
  ASSEMBLED
  /// Производственные данные изменились ПОСЛЕ завершения сборки.
  ///
  /// Складскую приёмку это состояние не блокирует: физически переданный заказ
  /// обязан быть учтён (`FUL-002` §2.6).
  NEEDS_REVIEW
}

/// Состояние задания печати бланка.
enum PrintJobState {
  PENDING
  PRINTED
  ERROR
}

/// Смена флориста.
///
/// Одновременно активная смена у пользователя ровно одна. Инвариант держит
/// база: `activeKey` равен идентификатору пользователя, пока смена открыта,
/// и обнуляется при закрытии. Уникальный индекс по нему даёт «не более одной
/// активной смены» без частичных индексов — тот же приём, что у одноразового
/// кода активации: NULL в PostgreSQL друг с другом не конфликтуют.
model FloristShift {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("FloristShiftUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  startedAt DateTime  @default(now())
  closedAt  DateTime?

  /// Равен `userId`, пока смена активна. После закрытия — `null`.
  activeKey String? @unique @db.Uuid

  closeKind   FloristShiftCloseKind?
  /// Кто закрыл. У принудительного закрытия это администратор.
  closedById  String?                @db.Uuid
  closedBy    User?                  @relation("FloristShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Причина администратора. Для `ADMIN_FORCED` обязательна (CHECK базы).
  closeReason String?

  assignments DeliveryOrder[] @relation("OrderFulfillmentShift")

  @@index([userId, startedAt])
  @@index([closedAt])
}

/// Неизменяемый снимок печатного бланка.
///
/// PDF собирается ИЗ НЕГО, а не из живого заказа. Иначе повторная печать после
/// изменения заказа выдала бы другой бланк под тем же номером, и к букету
/// оказался бы приложен документ, которого никто не собирал.
///
/// Адреса, телефона, цены и фотографий здесь нет: бланк их не показывает
/// (`FUL-002` §2.5), а значит и хранить их в снимке незачем.
model OrderPrintForm {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Производственная ревизия, использованная при сборке.
  revisionId String                   @db.Uuid
  revision   OrderFulfillmentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Версия шаблона бланка. Меняется вместе с формой, чтобы старый бланк
  /// оставался воспроизводимым ровно таким, каким его печатали.
  templateVersion Int

  /// Данные бланка: номер, московские дата и интервал, состав, текст открытки
  /// и нижний комментарий. Только перечисленное.
  snapshot     Json
  snapshotHash String

  createdAt DateTime @default(now())

  jobs OrderPrintJob[]

  @@index([orderId, createdAt])
}

/// Задание печати бланка.
///
/// Повторная печать создаёт НОВОЕ задание по тому же снимку, а не переписывает
/// прежнее: история попыток — часть доказательства того, что бланк вообще
/// печатали. Состояние «Собран» от печати не зависит и ею не откатывается.
model OrderPrintJob {
  id      String        @id @default(uuid(7)) @db.Uuid
  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  printFormId String         @db.Uuid
  printForm   OrderPrintForm @relation(fields: [printFormId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  state PrintJobState @default(PENDING)
  /// Номер попытки для заказа, начиная с 1.
  attempt Int

  /// Печать подтверждена человеком: в MVP это штатный путь, а не отказ.
  /// Windows-службы бездиалоговой печати в этом срезе нет.
  completedAt   DateTime?
  completedById String?   @db.Uuid
  completedBy   User?     @relation("PrintJobCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Безопасный короткий код последней ошибки. Ни состава, ни PII.
  lastErrorCode String?
  lastErrorAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, attempt])
  @@index([state, createdAt])
  @@index([orderId, createdAt])
}

/// Курсор фоновой синхронизации. Отделён от `IntegrationStatus.details`:
/// это рабочее состояние процесса, а не отображаемая диагностика.
///
/// В ветке 3.1 только моделируется; планировщик и проходы появятся в 3.2.
model IntegrationCursor {
  id       String @id @default(uuid(7)) @db.Uuid
  provider String @unique

  /// Верхняя граница обработанного окна по `updated`.
  updatedCursor          DateTime?
  initialLoadCompleted   Boolean   @default(false)
  initialLoadCompletedAt DateTime?
  lastReconciliationAt   DateTime?

  /// Завершена ли загрузка ПРОИЗВОДСТВЕННОЙ области.
  ///
  /// Отдельный признак нужен ровно для одного перехода: база, где узкий
  /// логистический initial уже завершён, никогда не читала заказы утверждённого
  /// склада с другим способом получения. Простая замена фильтра оставила бы их
  /// непрочитанными навсегда, потому что delta ходит по окну `updated`.
  ///
  /// На чистой базе оба признака закрываются одним широким проходом: двух
  /// одинаковых полных загрузок не бывает.
  fulfillmentLoadCompleted   Boolean   @default(false)
  fulfillmentLoadCompletedAt DateTime?

  /// Состояние восстановления после сбоя: переживает перезапуск процесса,
  /// поэтому backoff не обнуляется рестартом и не превращается в частый повтор.
  lastAttemptAt       DateTime?
  consecutiveFailures Int       @default(0)
  nextAttemptAt       DateTime?

  /// Техническая версия для безопасного конкурентного обновления.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Этап 4.1. Ручные маршруты-черновики -------------------------------------

/// Состояние маршрута.
///
/// CONFIRMED и CANCELLED объявлены заранее: они нужны модели этапа 4 целиком,
/// но переходы из DRAFT появятся только в ветке 4.2. ACTIVE и COMPLETED
/// сознательно не добавляются — их введёт forward-only миграция этапа 6.
enum RouteState {
  DRAFT
  CONFIRMED
  CANCELLED
  /// Маршрут физически передан курьеру (этап 6.5). Значение добавлено в КОНЕЦ:
  /// PostgreSQL хранит порядок объявления, и вставка в середину сдвинула бы
  /// существующие значения. `COMPLETED` появится вместе с работой курьера.
  ACTIVE
}

/// Почему заказ покинул состав маршрута.
enum RouteOrderRemovalReason {
  /// Возвращён в нераспределённые.
  RETURNED_TO_UNASSIGNED
  /// Перемещён в другой маршрут; целевой маршрут записан в movedToRouteId.
  MOVED_TO_ANOTHER_ROUTE
  /// Маршрут отменён: участие закрывается вместе с ним, история сохраняется.
  ROUTE_CANCELLED
}

/// Известное расхождение уже распределённого заказа с маршрутом.
///
/// Заказ при этом НЕ удаляется из маршрута автоматически: молчаливое исключение
/// лишило бы логиста возможности заметить проблему. Разрешение всегда ручное.
enum RouteOrderConflictKind {
  /// Дата доставки в МоемСкладе перестала совпадать с датой маршрута.
  DELIVERY_DATE_CHANGED
  /// Заказ вышел из нашей области: другой склад или другой способ доставки.
  SCOPE_LOST
  /// Источник не найден контрольной сверкой.
  SOURCE_MISSING
  /// Источник архивирован в МоемСкладе.
  SOURCE_ARCHIVED
}

/// Маршрут доставки. На этапе 4.1 создаётся только вручную и только как черновик.
///
/// Физическое удаление запрещено триггером: маршрут отменяется с причиной,
/// но не стирается — иначе исчезла бы история распределения заказов.
model DeliveryRoute {
  id String @id @default(uuid(7)) @db.Uuid

  /// Понятный человеку номер вида R-2026-08-07-003. PII не содержит.
  /// Выдаётся атомарно через RouteNumberCounter в той же транзакции.
  number String @unique

  /// Календарная дата Москвы. После создания не изменяется (триггер базы):
  /// перенос на другой день выполняется созданием другого черновика.
  deliveryDate DateTime @db.Date

  state       RouteState  @default(DRAFT)
  vehicleType VehicleType

  /// Назначенный курьер. Пустое значение допустимо: маршрут может существовать
  /// без курьера, назначение состояние маршрута не меняет.
  courierUserId String? @db.Uuid
  courier       User?   @relation("RouteCourier", fields: [courierUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdById String @db.Uuid
  createdBy   User   @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Оптимистическая блокировка. За одну логическую операцию увеличивается ровно один раз.
  version Int @default(1)

  /// Склад начала и склад конца смены (этап 5.4).
  ///
  /// Оба необязательны: миграция не может создать склад, а ручная маршрутизация
  /// обязана работать до того, как администратор его настроит. Для маршрута,
  /// созданного планированием, база требует оба (CHECK `DeliveryRoute_plan_depots`):
  /// автоматический маршрут без точки отсчёта не воспроизводим.
  startDepotId String? @db.Uuid
  startDepot   Depot?  @relation("RouteStartDepot", fields: [startDepotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endDepotId   String? @db.Uuid
  endDepot     Depot?  @relation("RouteEndDepot", fields: [endDepotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Запуск планирования, породивший маршрут. Пусто у ручного черновика.
  planRunId String?       @db.Uuid
  planRun   RoutePlanRun? @relation(fields: [planRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Слот машины, породивший маршрут.
  ///
  /// Уникален: один слот не может дать два маршрута. Без этого повторное
  /// применение одного запуска создало бы вторую копию плана, и заказы
  /// оказались бы распределены дважды.
  planVehicleSlotId String?               @unique @db.Uuid
  planVehicleSlot   RoutePlanVehicleSlot? @relation(fields: [planVehicleSlotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        RouteOrder[]           @relation("RouteOrderRoute")
  movedInOrders RouteOrder[]           @relation("RouteOrderMovedTo")
  transitions   RouteStateTransition[]
  editLease     RouteEditLease?
  cellBindings  RouteCellBinding[]
  issueSessions RouteIssueSession[]

  @@index([deliveryDate, state])
  @@index([courierUserId])
  @@index([planRunId])
}

/// Участие заказа в маршруте с историей.
///
/// Строка не удаляется и не оживляется: повторное добавление ранее удалённого
/// заказа создаёт НОВУЮ строку. Так история распределения остаётся доказательством
/// того, кто, когда и куда переносил заказ.
model RouteOrder {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation("RouteOrderRoute", fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Позиция в маршруте, начиная с 1. Уникальна среди активных участий маршрута.
  position Int

  addedById String   @db.Uuid
  addedBy   User     @relation("RouteOrderAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedAt   DateTime @default(now())

  /// Три поля удаления заполняются вместе и после фиксации не изменяются.
  removedById   String?                  @db.Uuid
  removedBy     User?                    @relation("RouteOrderRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedAt     DateTime?
  removalReason RouteOrderRemovalReason?

  /// Куда ушёл заказ при перемещении. Обязателен ровно при MOVED_TO_ANOTHER_ROUTE.
  movedToRouteId String?        @db.Uuid
  movedToRoute   DeliveryRoute? @relation("RouteOrderMovedTo", fields: [movedToRouteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  conflicts RouteOrderConflict[]

  @@index([routeId, position])
  @@index([orderId])
}

/// Конфликт распределённого заказа. Неизменяемая запись.
///
/// Отдельная таблица, а не поле участия: заказ может одновременно сменить дату,
/// выйти из области и оказаться архивированным, и одно поле потеряло бы часть причин.
/// Пара (участие, вид) уникальна, поэтому повторный overlap-проход синхронизации
/// не создаёт дубликат и не уведомляет логистов второй раз.
model RouteOrderConflict {
  id String @id @default(uuid(7)) @db.Uuid

  routeOrderId String     @db.Uuid
  routeOrder   RouteOrder @relation(fields: [routeOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  kind       RouteOrderConflictKind
  detectedAt DateTime               @default(now())

  @@unique([routeOrderId, kind])
  @@index([routeOrderId])
}

/// Счётчик номеров маршрутов по дням.
///
/// Инкремент выполняется одним оператором INSERT ... ON CONFLICT DO UPDATE
/// в той же транзакции, что и создание маршрута: откат создания откатывает
/// и номер. Сериализуются только маршруты одного дня.
model RouteNumberCounter {
  deliveryDate DateTime @id @db.Date
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Неизменяемая история переходов состояния маршрута.
///
/// `DeliveryRoute.state` — текущее состояние, эта таблица — доказательство того,
/// кто, когда и почему его менял. Причина после записи не изменяется: переписанное
/// объяснение отмены обесценило бы всю историю.
model RouteStateTransition {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fromState RouteState
  toState   RouteState

  actorUserId String @db.Uuid
  actor       User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  occurredAt DateTime @default(now())

  /// Обязательна при возврате в черновик и при отмене; при подтверждении отсутствует.
  /// Длина ограничена базой: 3–500 символов.
  reason String?

  @@index([routeId, occurredAt])
}

/// Мягкая блокировка редактора черновика.
///
/// Одна строка на маршрут: это операционное состояние «кто сейчас редактирует»,
/// а не история — история действий с блокировкой живёт в `AuditLog`.
///
/// Держатель определяется парой «пользователь + семья сессий»: один человек
/// с двух устройств — это два редактора, и второе устройство не должно молча
/// перехватывать правки первого.
///
/// Блокировка мягкая: она истекает по времени, её можно безопасно перехватить,
/// и она не держит открытой транзакцию PostgreSQL между запросами.
model RouteEditLease {
  routeId String        @id @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  holderUserId String @db.Uuid
  holder       User   @relation(fields: [holderUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Семья сессий устройства. Наружу не возвращается никогда.
  holderFamilyId String @db.Uuid

  acquiredAt  DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  expiresAt   DateTime
  releasedAt  DateTime?

  /// Версия для конкурентного перехвата: takeover обязан назвать ту, что видел.
  version Int @default(1)

  @@index([holderUserId])
  @@index([expiresAt])
}

// --- Этап 5.1. Геоданные заказа ---------------------------------------------

/// Состояние георазрешения адреса заказа.
enum OrderGeoState {
  /// Точка ещё не запрашивалась.
  UNRESOLVED
  /// Запрос к геокодеру поставлен в очередь (ветка 5.2).
  PENDING
  /// Точка пригодна для планирования.
  RESOLVED
  /// Точка есть в истории, но пользоваться ею нельзя: нужна проверка человеком.
  NEEDS_REVIEW
  /// Геокодер отказал окончательно.
  FAILED
}

/// Откуда взялась точка.
enum OrderGeoSource {
  /// Production-геокодер (ветка 5.2).
  DADATA
  /// Логист поставил точку руками.
  MANUAL
  /// Синтетический набор staging. Production-процесс такие точки не создаёт.
  SYNTHETIC
}

/// Насколько точно найден адрес.
enum OrderGeoPrecision {
  EXACT_HOUSE
  NEARBY_HOUSE
  STREET
  LOCALITY
  UNKNOWN
}

/// Почему точка требует проверки.
enum OrderGeoReviewReason {
  /// Адрес в МоемСкладе изменился: прежняя точка больше не относится к заказу.
  ADDRESS_CHANGED
  /// Геокодер нашёл только улицу или населённый пункт.
  LOW_PRECISION
  /// Провайдер вернул отказ или не ответил.
  PROVIDER_FAILED
  /// Проверку запросил человек.
  MANUAL_CHECK
}

/// Что произошло с геоданными заказа.
enum OrderGeoChangeKind {
  /// Логист поставил точку руками.
  MANUAL_SET
  /// Точка обесценена сменой адреса.
  INVALIDATED_ADDRESS_CHANGED
  /// Адрес поставлен в очередь геокодирования.
  GEOCODE_REQUESTED
  /// Провайдер вернул точный дом.
  GEOCODE_RESOLVED
  /// Провайдер ответил, но точность недостаточна: нужна проверка человеком.
  GEOCODE_LOW_PRECISION
  /// Повторы исчерпаны: провайдер не смог ответить.
  GEOCODE_FAILED
}

/// Состояние задания геокодирования.
enum GeocodeJobStatus {
  PENDING
  PROCESSING
  /// Задание завершено: результат применён либо признан устаревшим.
  DONE
  /// Повторы исчерпаны. Заказ переведён в FAILED и ждёт человека.
  FAILED
}

/// Очередь геокодирования адресов.
///
/// Отдельная таблица, а не тема существующего outbox: обработчик outbox
/// выполняется ВНУТРИ транзакции, а держать транзакцию открытой во время
/// обращения к внешнему сервису нельзя — соединение с базой занималось бы
/// на всё время сетевой задержки, а строка заказа оставалась бы заблокированной.
///
/// Адреса здесь нет намеренно. Задание ссылается на заказ и поколение адреса,
/// а сам адрес читается из заказа непосредственно перед запросом. Так очередь
/// не превращается во вторую копию персональных данных, а ответ, вернувшийся
/// после смены адреса, невозможно применить к новому адресу по ошибке.
model OrderGeocodeJob {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Поколение адреса на момент постановки. Вместе с orderId — тождество задания.
  geoGeneration Int

  status        GeocodeJobStatus @default(PENDING)
  attempts      Int              @default(0)
  maxAttempts   Int              @default(5)
  nextAttemptAt DateTime         @default(now())

  /// Аренда: кто и когда взял задание в работу.
  lockedAt DateTime?
  lockedBy String?

  /// Только безопасный код отказа. Ни текста провайдера, ни адреса, ни координат.
  lastErrorCode String?
  /// Сколько раз результат оказался устаревшим. Полезно при разборе, PII не содержит.
  staleResults  Int     @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  /// Одно задание на одно поколение адреса: повтор того же снимка не создаёт дубликат.
  @@unique([orderId, geoGeneration])
  @@index([status, nextAttemptAt])
}

/// Есть ли данные о текущей дорожной обстановке в расчёте.
///
/// Собственная Valhalla считает по статическим скоростям OSM. Называть это
/// «пробками» нельзя: цифра выглядела бы как знание о текущей ситуации,
/// которого у нас нет. Режим хранится вместе с результатом и входит в ключ
/// кэша, поэтому платный источник времени можно будет добавить позже,
/// не переписывая доменную модель и не смешивая старые расчёты с новыми.
enum TrafficMode {
  /// Данных о времени в пути нет вовсе.
  NONE
  /// Статические скорости дорожного графа. Текущей обстановки не отражают.
  STATIC
}

enum MatrixCacheStatus {
  /// Расчёт занят одним экземпляром приложения. Остальные ждут результата.
  PENDING
  READY
  /// Расчёт не удался. Ошибка не выдаётся за успех и не переживает TTL.
  FAILED
}

/// Кэш матриц времени и расстояния.
///
/// Матрица на N точках — это N² пар, и повторять её расчёт при каждом
/// обращении к планировщику незачем: граф между запросами не меняется.
///
/// Исходные координаты здесь НЕ хранятся вторым снимком: в ключ входит их
/// упорядоченный набор, а наружу уходит только SHA-256 ключа. Так кэш не
/// становится ещё одной копией геоданных заказов.
model RouteMatrixCache {
  id String @id @default(uuid(7)) @db.Uuid

  /// SHA-256 канонического ключа: ревизия графа, профиль, режим трафика,
  /// упорядоченный набор координат и влияющие на расчёт параметры.
  keyHash String @unique

  /// Прежнее обозначение графа. Оставлено для работающей предыдущей версии.
  ///
  /// Хранило Unix-время изменения tiles.tar. Источником истины больше
  /// не является и для поиска новой версией не используется; колонка живёт
  /// до отдельной contract-миграции, потому что при отказе запуска новой
  /// версии продолжает работать прежняя — с этой же схемой.
  graphRevision String

  /// Идентичность дорожного графа: SHA-256 файла tiles.tar.
  ///
  /// Единственный признак того, по какому графу получен расчёт. Содержимое,
  /// а не время файла: скопированный набор остаётся тем же графом, а
  /// подменённый с прежним временем — не остаётся. Формат закреплён
  /// ограничением базы: ровно 64 шестнадцатеричных символа в нижнем регистре.
  ///
  /// Допускает NULL: строки предыдущей версии его не содержат, и для новой
  /// версии они тем самым невидимы.
  graphSha256 String?
  profile     VehicleType
  trafficMode TrafficMode
  pointCount  Int

  status MatrixCacheStatus @default(PENDING)

  /// Направленные матрицы: целые секунды и целые метры. Недостижимая пара —
  /// явный null, а не ноль: ноль означал бы «точки совпадают».
  durationsSec Json?
  distancesM   Json?

  computedAt DateTime?
  expiresAt  DateTime?

  /// Аренда расчёта: два экземпляра не считают один ключ одновременно.
  lockedAt DateTime?
  lockedBy String?

  attempts      Int     @default(0)
  /// Только безопасный код отказа. Ни координат, ни тела ответа.
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([status, lockedAt])
}

/// Общее состояние провайдера геокодирования.
///
/// Экземпляров приложения несколько, а лимит темпа, баланс и ключ у провайдера
/// общие. Поле «время последнего запроса» внутри объекта клиента ничего не знает
/// о запросе соседнего процесса, поэтому и минимальный интервал, и пауза после
/// 429, и остановка при неверном ключе живут в базе, а не в памяти.
model GeocodingProviderState {
  /// Singleton: строка ровно одна.
  id String @id @default("dadata")

  /// Раньше этого времени следующий запрос начинать нельзя.
  /// Обслуживает и обычный интервал между запросами, и паузу после 429.
  nextRequestAllowedAt DateTime @default(now())

  /// Причина полной остановки обращений: неверный ключ, отозванные права,
  /// отсутствие ключей. Снимается только при запуске с исправленной настройкой.
  haltedReason String?
  haltedAt     DateTime?

  updatedAt DateTime @updatedAt
}

/// Неизменяемая история геоданных заказа.
///
/// Адрес здесь не хранится намеренно: история отвечает на вопрос «какая точка
/// была и почему она сменилась», а сам адрес живёт в заказе и его ревизиях.
/// Сырые ответы будущих провайдеров тоже не сохраняются.
model OrderGeoHistory {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  kind       OrderGeoChangeKind
  occurredAt DateTime           @default(now())

  /// Состояние и точка ПОСЛЕ изменения. У инвалидации координат нет.
  state     OrderGeoState
  source    OrderGeoSource?
  precision OrderGeoPrecision?
  latMicro  Int?
  lonMicro  Int?

  /// Прежняя точка: она перестаёт быть текущей, но остаётся доказательством.
  previousLatMicro Int?
  previousLonMicro Int?

  reviewReason OrderGeoReviewReason?
  /// Пояснение человека. Обязательно для ручной установки, 3–500 символов.
  reason       String?

  /// Автор. Пусто у системной инвалидации: её выполняет синхронизация.
  actorUserId String? @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, occurredAt])
}

// --- Этап 5.4. Склады, планирование маршрутов и автоматические черновики -----

/// Склад — предметная сущность, а не настройка.
///
/// Его координаты участвуют в маршрутах, матрицах и истории планирования:
/// на склад ссылаются уже посчитанные планы, и спрятать его в `SystemSetting`
/// значило бы отложить неизбежное.
///
/// Записи не удаляются никогда (триггер на DELETE): маршруты и снимки
/// планирования ссылаются на склад, и удаление оставило бы историю без точки
/// отсчёта. Недоступность выражается признаком `isActive`.
model Depot {
  id String @id @default(uuid(7)) @db.Uuid

  name    String
  address String

  /// Координаты целыми микроградусами — та же точность, что у заказа.
  /// Пределы закреплены ограничениями базы, а не только кодом.
  latMicro Int
  lonMicro Int

  isActive Boolean @default(true)

  /// Пока склад является складом по умолчанию, поле равно 'default'; иначе NULL.
  /// Уникальный индекс по нему даёт «не более одного склада по умолчанию»
  /// средствами базы: NULL в PostgreSQL не конфликтуют.
  ///
  /// База дополнительно требует, чтобы склад по умолчанию был активен
  /// (CHECK `Depot_default_active`): состояние «выключен, но по умолчанию»
  /// физически невозможно, даже если проверка в коде когда-нибудь исчезнет.
  defaultKey String? @unique

  /// Оптимистическая блокировка. Любое изменение склада называет ожидаемую версию.
  version Int @default(1)

  createdById String @db.Uuid
  createdBy   User   @relation("DepotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startedRoutes DeliveryRoute[]        @relation("RouteStartDepot")
  endedRoutes   DeliveryRoute[]        @relation("RouteEndDepot")
  startedSlots  RoutePlanVehicleSlot[] @relation("PlanSlotStartDepot")
  endedSlots    RoutePlanVehicleSlot[] @relation("PlanSlotEndDepot")

  @@index([isActive])
}

/// Состояние запуска планирования.
///
/// Расчёт и применение разделены намеренно: `PREVIEW` — это неизменяемое
/// предложение, которое логист видит целиком (маршруты и неразмещённые заказы)
/// до того, как в системе появится хоть один черновик.
enum RoutePlanRunState {
  /// Принят, аренда расчёта ещё не взята.
  QUEUED
  /// Считается. Аренда с `lockedUntil` и сердцебиением.
  COMPUTING
  /// Готовое неизменяемое превью. Черновиков ещё нет.
  PREVIEW
  /// Подтверждено человеком: черновики созданы.
  APPLIED
  /// Отказ с безопасным кодом. Автоматически не повторяется.
  FAILED
  /// Превью снято с рассмотрения: истекло явным действием либо вход устарел.
  EXPIRED
}

/// Запуск планирования маршрутов на один день.
model RoutePlanRun {
  id String @id @default(uuid(7)) @db.Uuid

  deliveryDate DateTime          @db.Date
  state        RoutePlanRunState @default(QUEUED)

  /// Пока запуск не завершён (QUEUED, COMPUTING, PREVIEW), поле равно дате
  /// доставки; у завершённых — NULL. Уникальный индекс по нему запрещает два
  /// одновременных запуска одного дня средствами базы, а не «маловероятностью».
  ///
  /// Именно поэтому превью не вытесняется молча: новый расчёт того же дня
  /// возможен только после явного истечения прежнего.
  activeDateKey DateTime? @unique @db.Date

  requestedById String @db.Uuid
  requestedBy   User   @relation("PlanRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Аренда расчёта по СЕРВЕРНОМУ времени. Перехват допустим только после
  /// истечения `lockedUntil`; сердцебиение продлевает его, пока процесс жив.
  lockedUntil DateTime?
  lockedBy    String?
  heartbeatAt DateTime?

  /// Сколько раз расчёт восстанавливали после падения процесса. Обычная ошибка
  /// матрицы или решателя счётчик не увеличивает и повтора не вызывает.
  recoveryAttempts Int @default(0)

  /// Только безопасный код отказа: ни тел ответов, ни координат, ни адресов.
  failureCode String?

  appliedAt   DateTime?
  appliedById String?   @db.Uuid
  appliedBy   User?     @relation("PlanRunAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots  RoutePlanVehicleSlot[]
  input  RoutePlanInputSnapshot?
  result RoutePlanResultSnapshot?
  routes DeliveryRoute[]

  @@index([deliveryDate, state])
  @@index([state, lockedUntil])
}

/// Слот машины запуска планирования.
///
/// После постановки запуска строка неизменяема (триггер на UPDATE и DELETE):
/// перехват брошенной аренды обязан продолжить расчёт с теми же условиями,
/// с которыми он был поставлен.
model RoutePlanVehicleSlot {
  id String @id @default(uuid(7)) @db.Uuid

  runId String       @db.Uuid
  run   RoutePlanRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Порядковый номер слота начиная с 1. Он же — числовой идентификатор машины
  /// в запросе решателя: имён и описаний туда не уходит.
  slotIndex Int

  /// Курьер необязателен: слот может остаться без человека, и тогда его маршрут
  /// создаётся черновиком без назначения.
  courierUserId String? @db.Uuid
  courier       User?   @relation("PlanSlotCourier", fields: [courierUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vehicleType VehicleType

  /// Вместимость в ЗАКАЗАХ: один заказ — одна единица.
  capacityOrders Int

  /// Фактически использованная смена. Минуты от полуночи.
  shiftStartMinute Int
  shiftEndMinute   Int

  startDepotId String @db.Uuid
  startDepot   Depot  @relation("PlanSlotStartDepot", fields: [startDepotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endDepotId   String @db.Uuid
  endDepot     Depot  @relation("PlanSlotEndDepot", fields: [endDepotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  route DeliveryRoute?

  /// Один курьер не может занимать два слота одного запуска. Слоты без курьера
  /// не конфликтуют: NULL в PostgreSQL уникальности не нарушают.
  @@unique([runId, courierUserId])
  @@unique([runId, slotIndex])
}

/// Неизменяемый снимок ВХОДА планирования.
///
/// Создаётся ДО обращения к матрице и решателю. Иначе перехват брошенной аренды
/// не смог бы продолжить расчёт с первоначальными данными: заказы, настройки
/// и склад к тому моменту могли измениться, и повторная попытка дала бы другой
/// ответ на тот же запрос.
///
/// Адресов, получателей, номеров заказов, комментариев и денег здесь нет.
/// Координаты есть: без них воспроизвести расчёт нечем, а точки той же природы
/// уже хранит неизменяемая `OrderGeoHistory`.
model RoutePlanInputSnapshot {
  id String @id @default(uuid(7)) @db.Uuid

  runId String       @unique @db.Uuid
  run   RoutePlanRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Версии входных заказов, их точки и окна, параметры слотов, смены,
  /// время обслуживания, координаты и версии складов, предел размера задачи.
  payload     Json
  /// SHA-256 канонического снимка: дешёвое сравнение без разбора JSON.
  payloadHash String

  createdAt DateTime @default(now())
}

/// Неизменяемый снимок РЕЗУЛЬТАТА планирования.
///
/// Создаётся при переходе в `PREVIEW`. Хранит нормализованный числовой запрос
/// к решателю и его ответ целиком: при пределе в шестьдесят точек это небольшой
/// объём, а воспроизводимость получается настоящая. Ни адресов, ни координат,
/// ни номеров заказов в запросе решателя нет — только индексы и числа.
model RoutePlanResultSnapshot {
  id String @id @default(uuid(7)) @db.Uuid

  runId String       @unique @db.Uuid
  run   RoutePlanRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Идентичность дорожного графа, по которому посчитаны матрицы.
  graphSha256   String
  /// Ключи кэша использованных матриц по профилям.
  matrixKeys    Json
  /// Версия решателя из его же ответа.
  solverVersion String

  /// Числовой запрос к решателю как он был отправлен.
  request  Json
  /// Ответ решателя как он был получен.
  response Json
  /// Разобранный план: маршруты по слотам и неразмещённые заказы.
  plan     Json

  createdAt DateTime @default(now())
}

// --- Этап 6.4. Складские ячейки ----------------------------------------------

/// Тип складской ячейки.
///
/// Значения ровно два (`FUL-003`). Отдельный тип «для отменённых» сознательно
/// не вводится: отменённый заказ остаётся в обычной ячейке хранения с пометкой.
enum StorageCellKind {
  /// Обычная ячейка хранения собранного заказа.
  STORAGE
  /// Ячейка, в которую комплектуется подтверждённый маршрутный лист.
  ROUTE
}

/// Складская ячейка — физическое место внутри склада.
///
/// Это НЕ логистический `Depot` (`FUL-004`): `Depot` — точка старта и конца
/// маршрута с координатами, ячейка — полка внутри здания. Координат, вместимости
/// и связи с маршрутом здесь нет: вместимость владельцем не моделируется, а
/// привязка маршрутного листа появится вместе с размещениями отдельным срезом.
///
/// Записи не удаляются никогда (триггер `storage_cell_no_delete`): на ячейку
/// будет ссылаться неизменяемая история перемещений, и удаление оставило бы
/// историю без места. Недоступность выражается признаком `isActive`.
model StorageCell {
  id String @id @default(uuid(7)) @db.Uuid

  /// Код в том виде, в котором его ввёл администратор: только этот вариант
  /// печатается на этикетке и показывается человеку.
  code           String
  /// Тот же код, приведённый к сравнимому виду (NFKC + верхний регистр,
  /// внешние пробелы убраны). Уникален: скан `a-01` не должен выбрать `A-01`
  /// как другую ячейку.
  ///
  /// Оба поля неизменяемы после создания (триггер `storage_cell_code_immutable`):
  /// напечатанная этикетка не должна молча начать указывать на переименованную
  /// ячейку. Ошибочный код исправляется деактивацией и созданием новой ячейки.
  normalizedCode String @unique

  kind     StorageCellKind
  isActive Boolean         @default(true)

  /// Оптимистическая блокировка. Любое изменение называет ожидаемую версию.
  version Int @default(1)

  createdById String @db.Uuid
  createdBy   User   @relation("StorageCellCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Кто изменил ячейку последним. Пусто, пока её только создали.
  changedById String? @db.Uuid
  changedBy   User?   @relation("StorageCellChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements   OrderPlacement[]   @relation("PlacementCell")
  movedInto    OrderPlacement[]   @relation("PlacementMovedToCell")
  movedFrom    OrderPlacement[]   @relation("PlacementFromCell")
  routeBindings RouteCellBinding[]

  @@unique([id, kind])
  @@index([isActive, kind])
}

// --- Этап 6.5. Фактическое движение заказов по складу -------------------------

/// Почему заказ покинул ячейку.
enum PlacementReleaseReason {
  /// Перенесён в маршрутную ячейку при комплектовании.
  MOVED_TO_ROUTE_CELL
  /// Возвращён в обычное хранение.
  MOVED_TO_STORAGE
  /// Выдан курьеру.
  ISSUED_TO_COURIER
  /// Изъят со склада без выдачи: брак, отмена, возврат флористу.
  WITHDRAWN
}

/// Как заказ попал в ячейку.
enum PlacementSource {
  /// Первая приёмка собранного заказа на склад.
  RECEIVED
  /// Перемещение из другой ячейки.
  MOVED
}

/// Фактическое местоположение заказа и вся история его движений.
///
/// Отдельной колонки «текущая ячейка» у заказа нет намеренно — это был бы второй
/// источник истины, который база согласовать не может. Текущее местоположение —
/// это строка с пустым `releasedAt`, и частичный уникальный индекс
/// `OrderPlacement_active_order_unique` физически запрещает второе такое место.
///
/// Строка после освобождения неизменяема (триггер): повторное размещение создаёт
/// НОВУЮ строку, и история движений получается сама, а не отдельной копией.
/// Молча переписать `cellId` нельзя — это тоже запрещает триггер: перемещение
/// обязано быть видимым действием с автором и временем.
model OrderPlacement {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String        @db.Uuid
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Куда положили.
  cellId String      @db.Uuid
  cell   StorageCell @relation("PlacementCell", fields: [cellId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Откуда пришёл заказ. Пусто при первой приёмке.
  fromCellId String?      @db.Uuid
  fromCell   StorageCell? @relation("PlacementFromCell", fields: [fromCellId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  source PlacementSource

  /// UTC-инстант: база работает в UTC, московский день считается отдельно.
  placedAt   DateTime @default(now())
  placedById String   @db.Uuid
  placedBy   User     @relation("PlacementPlacedBy", fields: [placedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Три поля освобождения заполняются вместе и после фиксации не изменяются.
  releasedAt    DateTime?
  releasedById  String?                 @db.Uuid
  releasedBy    User?                   @relation("PlacementReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releaseReason PlacementReleaseReason?

  /// Куда ушёл заказ при перемещении. Обязателен ровно при переносе.
  movedToCellId String?      @db.Uuid
  movedToCell   StorageCell? @relation("PlacementMovedToCell", fields: [movedToCellId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Сессия выдачи. Обязательна ровно при `ISSUED_TO_COURIER`.
  issueSessionId String?            @db.Uuid
  issueSession   RouteIssueSession? @relation(fields: [issueSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Заказ лежит в маршрутной ячейке маршрута, который вернули в черновик
  /// или отменили. Система не переносит его молча: физическое место меняет
  /// только человек штатным сканированием.
  requiresRelocation Boolean @default(false)

  @@index([orderId, placedAt])
  @@index([cellId])
  @@index([issueSessionId])
}

/// Привязка маршрутной ячейки к подтверждённому маршрутному листу.
///
/// Одна активная привязка на маршрут и одна на ячейку — частичные уникальные
/// индексы. Тип ячейки продублирован колонкой и связан составным внешним ключом
/// с `StorageCell(id, kind)`: обычный внешний ключ не умеет выразить «только
/// ячейка типа ROUTE», а проверка в коде обходится одним запросом.
model RouteCellBinding {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  cellId   String          @db.Uuid
  cellKind StorageCellKind
  cell     StorageCell     @relation(fields: [cellId, cellKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)

  boundAt   DateTime @default(now())
  boundById String   @db.Uuid
  boundBy   User     @relation("RouteCellBoundBy", fields: [boundById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  releasedAt   DateTime?
  releasedById String?   @db.Uuid
  releasedBy   User?     @relation("RouteCellReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([routeId])
  @@index([cellId])
}

/// Состояние сессии выдачи маршрутного листа курьеру.
enum IssueSessionState {
  /// Курьер подтверждён, заказы выдаются поштучно.
  OPEN
  /// Выдан последний заказ; маршрут переведён в `ACTIVE`.
  COMPLETED
  /// Отменена администратором с причиной. Уже выданное остаётся в истории.
  CANCELLED
}

/// Сессия выдачи маршрутного листа назначенному курьеру.
///
/// Существует отдельно от маршрута, потому что выдача возобновляема: она
/// начинается подтверждением курьера, продолжается поштучным сканированием
/// и может быть прервана. Пока сессия открыта, маршрут остаётся `CONFIRMED`,
/// а частичный прогресс виден по выданным размещениям.
model RouteIssueSession {
  id String @id @default(uuid(7)) @db.Uuid

  routeId String        @db.Uuid
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Курьер, подтверждённый кладовщиком перед началом выдачи.
  courierUserId String @db.Uuid
  courier       User   @relation("IssueSessionCourier", fields: [courierUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  state IssueSessionState @default(OPEN)

  /// Пока сессия открыта, поле равно `routeId`; иначе NULL. Уникальный индекс
  /// по нему даёт «не более одной открытой сессии на маршрут» средствами базы.
  openKey String? @unique @db.Uuid

  confirmedAt   DateTime @default(now())
  confirmedById String   @db.Uuid
  confirmedBy   User     @relation("IssueSessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  completedAt DateTime?

  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelledBy   User?     @relation("IssueSessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelReason  String?

  version Int @default(1)

  placements OrderPlacement[]

  @@index([routeId, state])
}
