# Пример окружения. Реальные значения секретов сюда НЕ вписываются и не попадают в Git.
# Скопируйте файл в .env и заполните значения локально.

# --- Приложение ---
NODE_ENV=development
APP_ENV=local
# Маркер окружения; deploy-скрипты сверяют его с целевым хостом (staging|production).
APP_ENVIRONMENT_MARKER=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Europe/Moscow

# Доверие заголовкам прокси (X-Forwarded-For).
# Пусто или false — не доверять никому (значение по умолчанию и безопасный выбор).
# Число — доверять строго указанному количеству переходов.
# Список IP/CIDR через запятую — доверять только этим адресам.
# Значение true запрещено: оно позволило бы клиенту подделать свой IP
# и обойти rate limit. Заполняется только после появления reverse proxy.
TRUST_PROXY=

# --- База данных ---
# Формат: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=

# Отдельная одноразовая база для разрушающих критических тестов.
# Разрешены только имена fl_test и fl_ci: тесты создают записи, которые
# невозможно удалить, поэтому база разработки для них закрыта.
TEST_DATABASE_URL=

# --- Секреты приложения (генерируются локально, в Git не хранятся) ---
# Секрет подписи access-токенов (>= 32 байт, base64/hex).
AUTH_ACCESS_TOKEN_SECRET=
# Pepper для хеширования PIN (>= 32 байт).
AUTH_PIN_PEPPER=
# Ключ AES-256-GCM для кратковременного хранения преемника refresh-токена (32 байта, base64).
AUTH_REFRESH_REPLAY_KEY=

# --- МойСклад ---
# Имя переменной именно такое: приложение читает MOYSKLAD_TOKEN.
# Прежнее написание MOYSKLAD_API_TOKEN ошибочно — такую переменную код не читает.
#
# Токен административный по решению владельца: утверждённый контур позднее должен
# создавать «Отгрузки» и менять статусы. Полномочия записи разрешением на запись
# НЕ являются: интеграция остаётся read-only, а каждая будущая операция записи
# разрешается отдельным заданием с идемпотентностью и аудитом.
#
# ГДЕ ТОКЕН ДОПУСТИМ (решение владельца ENV-004).
#   production — чтение сейчас, запись в будущем отдельными заданиями;
#   staging    — ТОЛЬКО чтение: серверный HTTP-клиент обязан отклонять
#                POST/PUT/PATCH/DELETE ДО сетевого обращения. Отсутствие кнопки
#                и feature flag защитой не считаются;
#   local и CI — токена нет вовсе, обращений к живому API нет.
#
# Конфигурация fail closed: токен вне разрешённых окружений останавливает
# запуск. На staging он допустим только вместе с MOYSKLAD_READ_ONLY=true —
# совпавшего маркера окружения самого по себе недостаточно.
#
# Токен живёт только на сервере, в приватной конфигурации окружения.
# В SystemSetting, в клиентскую сборку, в Git, в логи, в отчёты и в аргументы
# команд он не попадает; браузеры к API МоегоСклада напрямую не обращаются.
MOYSKLAD_TOKEN=

# Режим «только чтение» серверного контура МоегоСклада.
#
# Значение НЕсекретное: оно доступ не выдаёт, а отнимает.
#
# Политика чтения БЕЗУСЛОВНА и этой переменной не управляется: единственная
# сетевая граница клиента сверяет HTTP-метод ДО вызова fetch и пропускает
# только GET и HEAD во всех окружениях, включая production. POST, PUT, PATCH,
# DELETE и неизвестный метод отвергаются без единого сетевого обращения.
#
# Переменная — это условие ДОПУСКА окружения к живому контуру:
#   true        — явное согласие; обязательно, чтобы staging принял токен
#                 или включённую синхронизацию;
#   не задано   — контур не настраивают. Безопасно, но живую staging-
#                 синхронизацию не разрешает;
#   false       — режим записи. Его ещё не существует, поэтому приложение
#                 останавливает запуск, а выкатка отказывает раньше.
#
# Операции записи в живой МойСклад вводятся отдельным заданием узкими
# именованными командами с идемпотентностью и аудитом (ENV-004, FUL-006).
MOYSKLAD_READ_ONLY=true

# Идентификатор статуса «Отменен» в МоемСкладе.
#
# Значение принадлежит конкретному аккаунту и в репозитории не хранится:
# в другом аккаунте у того же статуса другой идентификатор, а название
# администратор переименовывает в любой момент. Настоящее значение выдаёт
# владелец и оно живёт только в приватной конфигурации окружения.
#
# Пустое значение — это не «отмен не бывает», а «распознавание отмен
# выключено»: отменённым не считается ни один заказ. В local и staging это
# допустимо, в production приложение с пустым значением не стартует —
# иначе отменённые заказы молча уезжали бы клиентам.
MOYSKLAD_CANCELLED_STATE_ID=

# --- Внешние интеграции: на этапе 1 не подключаются ---
# Реальные токены выдаёт владелец; в SystemSetting и в клиент они не попадают.
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Photon: единственный автоматический геокодер ---
# Адрес СОБСТВЕННОГО Photon, например `http://photon:2322/api`. Пусто — геокодер
# честно считается ненастроенным: новые адреса остаются в «Требует внимания»,
# и точку ставит человек. Ни одного обращения наружу при этом не происходит.
#
# Публичные `photon.komoot.io` и `nominatim.openstreetmap.org` ЗАПРЕЩЕНЫ и
# отвергаются до обращения к сети: они не рассчитаны на рабочую нагрузку и
# увозят адреса клиентов третьей стороне.
#
# Путь `/api` обязателен: клиент дописывает параметры к ЭТОМУ адресу, а не
# к корню. Корневой адрес отвечает 404 на каждый запрос, и очередь трактует это
# как отказ сервиса при исправном геокодере.
#
# Окружение здесь не участвует намеренно: свой сервис не тратит чужих денег
# и не отдаёт адреса наружу, поэтому одинаково допустим и в local, и в production.
PHOTON_URL=

# Разрешено ли геокодеру самому обрабатывать всю очередь.
#
# Отдельное решение, а не следствие заданного PHOTON_URL. На новом наборе
# сначала нужен управляемый проход в два десятка запросов, а не молчаливая
# обработка всех накопленных заказов сразу.
#
# Fail closed: по умолчанию и при пустом значении автоматический режим выключен.
# Ручной проход `npm run geocode:backfill -- --limit N` работает при заданном
# PHOTON_URL независимо от этого флага — он и существует для пилота.
PHOTON_AUTO_GEOCODING_ENABLED=false

# Откуда собирать ЗАПРОС К ГЕОКОДЕРУ.
#
# Адрес заказа этим не управляется: он всегда операционный и приходит целиком —
# с квартирой, подъездом и домофоном, без которых курьер не доедет. Настройка
# влияет только на строку, которая уходит в Photon.
#
# `shipmentAddressFull` собирает её из разобранных частей МоегоСклада: индекс,
# страна, регион, город, улица и дом. Без улицы или дома запроса нет: заказ
# уходит к человеку, а адрес заказа его не подменяет.
#
# Значение временное; умолчание означает «отдельного запроса нет».
MOYSKLAD_GEOCODING_ADDRESS_SOURCE=shipmentAddress


# --- Новый адресный контракт (версия 2) ---
# Разводит два разных значения по смыслу: «Адрес» — город, улица и дом, только
# он уходит в геокодер, матрицу и маршрут; «Детали адреса» — регион, квартира
# и «Другое», их читают люди и наружу они не уходят никогда.
#
# Выключатель влияет РОВНО на одно: получит ли впервые создаваемый заказ
# версию контракта 2. Существующие заказы не меняются ни при каком значении,
# а уже созданные заказы версии 2 продолжают работать и после выключения.
#
# По умолчанию выключено намеренно: переход включается осознанно, контур
# за контуром. Стенд и направленные проверки передают `true` своей командой
# запуска, а не этим файлом.
MOYSKLAD_STRUCTURED_ADDRESS_V2_ENABLED=false


# --- Доля общего токена МоегоСклада ---
# Токен делят несколько сервисов, поэтому предел выбирается не по возможностям
# API, а по доле, которую мы согласны отнять у остальных. Умолчания сохраняют
# прежнее поведение: один запрос в секунду, последовательно, без резерва.
#
# Параллельность больше единицы клиент не поддерживает: очередь последовательна
# по построению, и значение здесь — явный договор, а не настройка.
#
# Резерв — неприкосновенный остаток окна лимита. Остаток общий: «осталось
# десять» означает не «нам можно ещё десять», а «всем вместе осталось десять».
MOYSKLAD_API_MAX_REQUESTS_PER_SECOND=1
MOYSKLAD_API_MAX_CONCURRENCY=1
MOYSKLAD_API_RESERVE_REQUESTS=0


# --- Нижняя граница даты доставки при импорте ---
# Московская календарная дата ГГГГ-ММ-ДД, граница ВКЛЮЧИТЕЛЬНАЯ. Нужна новому
# контуру: старые сделки в него переносить не нужно, а «перенести потом» нельзя —
# заказ создаётся один раз, и удаления заказов в системе нет.
#
# Это ограничение ОТБОРА, а не подмена даты: у созданного заказа дата доставки
# остаётся ровно той, что пришла из источника. Пустое значение сохраняет прежний
# набор импортируемых заказов; неверное — роняет запуск.
MOYSKLAD_IMPORT_DELIVERY_DATE_FROM=


# --- DaData: ТОЛЬКО подсказки в ручной правке адреса ---
# Платный Clean API не вызывается нигде, и клиента для него в коде нет
# (`docs/OWNER_DECISIONS.md`, GEO-005). Ключи нужны исключительно подсказкам,
# которые запрашивает человек, правящий адрес в «Требует внимания».
#
# Ключ РОВНО ОДИН. Подсказки авторизуются заголовком `Authorization: Token`;
# секретный ключ (`X-Secret`) требовался платному Clean API, которого в проекте
# нет. Переменной для него здесь нет намеренно: хранить на сервере секрет,
# который никуда не уходит, — лишний риск без единой причины.
#
# Ключ допустим в production и на staging — при СОВПАВШИХ маркерах окружения
# (`production`/`production` либо `staging`/`staging`). Владелец принял расход
# платной квоты на staging (`docs/OWNER_DECISIONS.md`, GEO-004). В local, CI
# и при смешанной конфигурации запуск с ключом останавливается.
# В браузер ключ не передаётся никогда.
DADATA_API_KEY=
# Серверные подсказки адреса. Автоматическое геокодирование этим флагом
# НЕ включается: его включает только `PHOTON_URL`.
# Допустимо в production и на staging при совпавших маркерах и только
# при заполненном ключе.
DADATA_GEOCODING_ENABLED=false

# --- Карта ---
# Адрес стиля MapLibre. Пусто — карта честно показывает «Карта не настроена»
# и ни к какому внешнему серверу не обращается. Публичный tile.openstreetmap.org
# и демонстрационные тайлы MapLibre в production запрещены.
MAP_STYLE_URL=
# Подпись правообладателя подложки, например «© OpenStreetMap contributors».
MAP_ATTRIBUTION=

# Каталог собственной подложки, смонтированный только на чтение.
# Внутри: manifest.json, style-*.json, tiles-*.pmtiles, sprite/, fonts/.
# Файлы лежат вне Git и вне образа; приложение сверяет их с манифестом при старте.
MAP_ARTIFACTS_PATH=

# --- Расчёт времени и расстояний ---
# Собственная Valhalla внутри сети Compose. Наружу не публикуется, в браузер
# адрес не передаётся никогда.
VALHALLA_URL=
# Ревизия дорожного графа. Входит в ключ кэша матриц; без неё расчёт невозможен.
VALHALLA_GRAPH_REVISION=
# Верхняя граница числа точек матрицы: она растёт квадратично.
MATRIX_MAX_POINTS=60
# Срок жизни готовой матрицы в секундах.
MATRIX_CACHE_TTL_SECONDS=86400

# Подменные решатель и матрица вместо VROOM и Valhalla.
#
# Нужны браузерной приёмке: она обязана проходить через настоящий серверный
# контракт, а не подменять HTTP-ответ в браузере. Настоящий расчёт требует
# дорожного графа и отдельных сервисов, которых в проверке нет.
#
# Подменный решатель НЕ оптимизирует: он раскладывает заказы подряд по
# вместимости. Значение допустимо только при APP_ENV=local — приложение
# отказывается стартовать с ним где угодно ещё.
PLANNING_TEST_SOLVER=false

# Подменённый HTTP подсказок адреса вместо живой DaData.
#
# Нужен браузерной приёмке: она обязана идти через настоящий серверный
# контракт подсказок, а живого ключа в проверках нет и быть не должно.
# Отвечает фиксированным набором адресов и наружу не ходит.
#
# Допустим только при APP_ENV=local — приложение отказывается стартовать
# с ним где угодно ещё: выдуманный адрес неотличим от настоящего.
DADATA_TEST_SUGGESTIONS=false
