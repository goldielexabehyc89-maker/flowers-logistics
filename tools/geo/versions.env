# Закреплённые версии картографических инструментов.
#
# Тег и digest вместе: тег читаем человеком, digest фиксирует ровно тот образ,
# который проверялся. Тег можно переставить на другой образ, digest — нельзя.
# `latest` не используется нигде: сборка обязана быть воспроизводимой через
# месяцы, а не «такой, какой получилась сегодня».
#
# Подтверждено по официальным репозиториям 09.08.2026.

# Генерация векторных тайлов и PMTiles из .osm.pbf.
PLANETILER_IMAGE="ghcr.io/onthegomap/planetiler:0.10.2"
PLANETILER_DIGEST="sha256:cf32202dbc001a9ab4bc11534b642b13de3798179817da8558e567a3d13dd403"

# Сборка дорожного графа и сервис маршрутизации.
VALHALLA_IMAGE="ghcr.io/valhalla/valhalla:3.8.3"
VALHALLA_DIGEST="sha256:70b45295d81035e3562e1bbf996a28d5fc55e1ccc5d7e3fff9f297d3b1a1359f"

# Решатель задачи маршрутизации. 1.15.0 — первая версия, в которой время
# обслуживания задаётся по типу транспорта (`service_per_type`). Более старая
# версия неизвестный ключ проигнорирует и вернёт план с нулевым временем
# обслуживания, поэтому нижняя граница здесь не пожелание, а требование.
VROOM_IMAGE="ghcr.io/vroom-project/vroom-docker:v1.15.0"
VROOM_DIGEST="sha256:247d5683d6745c755d718a156d16b16aac80baccc276a003a68b986c13883b08"
VROOM_VERSION="1.15.0"

# Раздача статики и HTTPS перед приложением.
CADDY_IMAGE="caddy:2.10-alpine"
CADDY_DIGEST="sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d"

# Опрос собранного графа при сборке: маленький образ с curl. Нужен, чтобы
# спросить у самой Valhalla фактическую ревизию набора тайлов, а не выдумывать её.
CURL_IMAGE="curlimages/curl:8.18.0"
CURL_DIGEST="sha256:d94d07ba9e7d6de898b6d96c1a072f6f8266c687af78a74f380087a0addf5d17"

# Формат архива тайлов: спецификация PMTiles v3.
PMTILES_SPEC_VERSION="3"
