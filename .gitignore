# Зависимости
node_modules/

# Сборка
dist/
build/
*.tsbuildinfo
apps/api/public/

# Сгенерированный Prisma-клиент
packages/db/generated/
**/generated/prisma/

# Секреты и локальное окружение — в Git не попадают никогда
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Дампы и выгрузки БД, потенциально содержащие PII
*.sql.gz
*.dump
*.bak
backups/

# Логи
*.log
logs/
npm-debug.log*

# Результаты тестов и отчёты
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Локальные артефакты деплоя
deploy/state/
# Реальные конфигурации выкатки: адреса, пользователи и отпечатки хостов.
# В Git хранятся только шаблоны deploy/*.conf.example.
deploy/private/
*.lock.d/

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Картографические архивы: сотни мегабайт, раздаются отдельно от репозитория.
*.pmtiles
*.mbtiles
*.osm.pbf
*.pbf
# Наборы картографических артефактов собираются отдельной операцией.
/geo-artifacts/

# Локальная подложка карты для приёмки: артефакт запуска, не исходный код.
.preview-basemap/
