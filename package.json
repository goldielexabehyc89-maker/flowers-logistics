{
  "name": "flowers-logistics",
  "version": "0.1.0",
  "private": true,
  "description": "Сервис логистики цветочного интернет-магазина (модульный монолит)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @fl/api\" \"npm run dev -w @fl/web\"",
    "build": "npm run build -w @fl/shared && npm run build -w @fl/web && npm run build -w @fl/api",
    "typecheck": "npm run build -w @fl/shared && tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:critical": "vitest run --config vitest.critical.config.ts",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "bootstrap:admin": "node apps/api/dist/scripts/bootstrap-admin.js",
    "bootstrap:admin:dev": "tsx apps/api/src/scripts/bootstrap-admin.ts",
    "logistics:pilot": "node apps/api/dist/scripts/logistics-pilot.js",
    "logistics:pilot:dev": "tsx apps/api/src/scripts/logistics-pilot.ts",
    "moysklad:sync-once": "node apps/api/dist/scripts/moysklad-sync-once.js",
    "moysklad:sync-once:dev": "tsx apps/api/src/scripts/moysklad-sync-once.ts",
    "start": "node apps/api/dist/index.js",
    "seed:e2e-order": "tsx apps/api/src/scripts/seed-e2e-order.ts",
    "seed:e2e-plan": "tsx apps/api/src/scripts/seed-e2e-plan.ts",
    "snapshot:import": "node apps/api/dist/scripts/snapshot-import.js",
    "snapshot:import:dev": "tsx apps/api/src/scripts/snapshot-import.ts",
    "snapshot:retire": "node apps/api/dist/scripts/snapshot-retire.js",
    "snapshot:retire:dev": "tsx apps/api/src/scripts/snapshot-retire.ts"
  },
  "dependencies": {
    "prisma": "7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "@playwright/test": "1.62.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true
  }
}
