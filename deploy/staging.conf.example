# Шаблон конфигурации staging.
#
# Рабочая копия: deploy/private/staging.conf — этот каталог игнорируется Git.
# В самом репозитории хранится только шаблон: реальные адреса и отпечатки
# в Git не попадают, а заполнение отслеживаемого файла сделало бы рабочее
# дерево грязным, после чего выкатка запретила бы сама себя.
#
#   mkdir -p deploy/private
#   cp deploy/staging.conf.example deploy/private/staging.conf
#
# Секреты приложения (пароль базы, ключи, pepper) здесь НЕ хранятся:
# они лежат только в файле окружения на самом сервере.

ENVIRONMENT_MARKER="staging"

SSH_HOST="CHANGE_ME_staging_host"
SSH_USER="CHANGE_ME_staging_user"
SSH_PORT="22"

# Строка формата known_hosts, полученная из доверенного источника.
HOST_FINGERPRINT="CHANGE_ME_staging_known_hosts_line"

# Каталог окружения на сервере. Когда staging и production стоят на одном
# сервере, именно каталог является границей между ними: в нём лежат файл
# ENVIRONMENT, файл окружения, deploy lock и список проверенных версий.
REMOTE_DIR="/srv/flowers-logistics-staging"

APP_DOMAIN="CHANGE_ME_staging_domain"

# Внешний порт на хосте. У окружений он обязан быть разным.
APP_HOST_PORT="3001"

# Приватный реестр GitHub Container Registry.
IMAGE_REPOSITORY="ghcr.io/goldielexabehyc89-maker/flowers-logistics"

# Отдельный project name: контейнеры и сети не пересекаются с production.
COMPOSE_PROJECT="fl-staging"

# Общий параметризованный Compose-файл; различия задаются этой конфигурацией.
COMPOSE_FILE="docker-compose.deploy.yml"

# Файл окружения и том базы — свои у каждого окружения.
ENV_FILE="staging.env"
DB_VOLUME="fl-staging-db"

# --- Картографические артефакты ---
#
# Каталоги лежат ВНЕ Git и вне образа приложения. Наборы неизменяемы: новая
# сборка кладётся в каталог с новым именем, а этот путь переключается на неё.
# Перезапись набора на месте запрещена — приложение читает файлы прямо сейчас.
#
# Допустимо, чтобы staging и production указывали на ОДИН И ТОТ ЖЕ набор
# одной ревизии: он неизменяем и одинаков. Контейнеры, тома, файлы окружения
# и кэши при этом остаются раздельными.
MAP_ARTIFACTS_DIR="/srv/geo/basemap/CHANGE_ME_revision"
VALHALLA_GRAPH_DIR="/srv/geo/valhalla/CHANGE_ME_revision"

# Идентичность дорожного графа: SHA-256 файла tiles.tar из его манифеста,
# ровно 64 шестнадцатеричных символа.
#
# Именно содержимое, а не время файла. Выкатка пересчитывает сумму лежащего
# на сервере файла и сводит её с манифестом и с этим значением; расхождение —
# отказ до запуска маршрутизатора. Время изменения файла и tileset_last_modified
# из /status идентичностью не являются: они меняются при копировании набора
# и не меняются при подмене его содержимого.
VALHALLA_GRAPH_SHA256="CHANGE_ME_tiles_tar_sha256"

# Образ маршрутизатора: тег и digest вместе. `latest` запрещён.
VALHALLA_IMAGE="ghcr.io/valhalla/valhalla:3.8.3@sha256:70b45295d81035e3562e1bbf996a28d5fc55e1ccc5d7e3fff9f297d3b1a1359f"

# Решатель задачи маршрутизации. Живёт в ОТДЕЛЬНОЙ внутренней сети Compose:
# ни одного проброса портов и никакого выхода наружу. Образ закреплён тегом
# И digest — `latest` запрещён.
VROOM_IMAGE="ghcr.io/vroom-project/vroom-docker:v1.15.0@sha256:247d5683d6745c755d718a156d16b16aac80baccc276a003a68b986c13883b08"

# Версия решателя для неизменяемого снимка результата планирования.
#
# Возможностью решателя это значение НЕ является: разное время обслуживания
# по типам транспорта появилось в 1.15.0, и выкатка проверяет его пробной
# задачей, а не доверием к этой строке.
VROOM_VERSION="1.15.0"
