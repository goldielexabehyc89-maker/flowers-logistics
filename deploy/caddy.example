# Пример обратного прокси для окружения.
#
# Реальная конфигурация лежит вне Git: домены и пути к сертификатам в репозиторий
# не попадают. Здесь — только форма, чтобы её не приходилось выводить заново.
#
# Наружу выходит ровно один сервис — приложение. Картографические артефакты
# раздаёт оно же по пути /maps, поэтому происхождение у стиля, шрифтов, спрайтов
# и PMTiles совпадает с интерфейсом само собой, без правил CORS и без второго
# публичного порта.
#
# Маршрутизатор Valhalla здесь не упоминается вовсе: он живёт внутри сети
# Compose и наружу не публикуется ни через прокси, ни портом.

example-staging.invalid {
	encode gzip

	# Приложение слушает только петлевой интерфейс. Внешний порт свой
	# у каждого окружения и задаётся в его конфигурации выкатки.
	reverse_proxy 127.0.0.1:3001 {
		# Диапазонные запросы обязаны доходить до приложения без изменений:
		# PMTiles читается кусками, и буферизация ответа свела бы формат на нет.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
}
